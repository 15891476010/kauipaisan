    private function compileNumberListGroupTotal(string $source, string $body, string $category, float $unitStake): ?array
    {
        $body = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $body) ?? $body;
        if (!preg_match('/^((?:\d{3}\s*){2,})\s*一(元)?组\s*(?:(?:计|合计|共计|共)\s*)?(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u', $body, $m)) return null;
        preg_match_all('/\d{3}/u', (string)$m[1], $numberMatches);
        $numbers = array_values(array_unique($numberMatches[0] ?? []));
        if ($numbers === []) return [$this->failure($source, '未识别到有效号码')];
        $categoryCount = $category === '福体' ? 2 : 1;
        $perStake = ($m[2] ?? '') === '元' ? 1.0 : $unitStake;
        $declared = $this->rules->amountWithUnit((float)$m[3], (string)($m[4] ?? ''), $unitStake);
        $expected = count($numbers) * $perStake * $categoryCount;
        if (abs($declared - $expected) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];

        $groups = ['组三' => [], '组六' => []];
        foreach ($numbers as $number) {
            $family = count(array_unique(str_split($number))) === 2 ? '组三' : (count(array_unique(str_split($number))) === 3 ? '组六' : null);
            if ($family !== null) $groups[$family][] = $number;
        }
        if ($groups['组三'] === [] && $groups['组六'] === []) return [$this->failure($source, '组合玩法选号形态不支持')];
        $rows = [];
        foreach ($groups as $play => $selected) {
            if ($selected === []) continue;
            $amount = count($selected) * $perStake * $categoryCount;
            $rows[] = $this->row($source, $body, $selected, $category, $play, $amount, count($selected) * $categoryCount, count($selected) * $categoryCount, '组', 1);
