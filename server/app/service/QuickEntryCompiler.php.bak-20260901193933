        // batch; carry it to unprefixed sibling tickets so their amounts use
        // both lottery categories (e.g. 180+60=240).
        $batchCategory = null;
        foreach ($blocks as $candidate) if (str_contains($candidate, '福体')) { $batchCategory = '福体'; break; }
