    /** Compile number lines followed by independent play/amount lines. */
    private function compileLeadingPlayMultilineBatch(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r?\n/u', $source) ?: []), static fn(string $line): bool => $line !== ''));
        if (count($lines) < 3) return null;
