                $row['arithmetic_amount'] = true;
                $rows[] = $row;
            }
            $operandIndex = count($operands);
        }
        $actual = array_sum(array_map(static fn(array $row): float => (float)($row['amount'] ?? 0), $rows));
        if (abs($actual - $declaredTotal) > 0.011) return null;
        foreach ($rows as &$row) {
            $row['raw_text'] = $source;
            $row['input_text'] = $source;
        }
        unset($row);
        return $rows;
    }

