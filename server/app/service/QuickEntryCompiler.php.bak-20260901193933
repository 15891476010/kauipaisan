    /** Compile several digit sets against one or more catalog families. */
    private function compileMultiCode(string $source, string $body, string $category, float $unitStake): ?array
    {
        $body = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $body) ?? $body;
        preg_match_all('/组三|组六|复式/u', $body, $familyMatches);
        $familyNames = array_values(array_unique($familyMatches[0] ?? []));
        $familyCount = count($familyNames);
        if ($familyCount < 1) return null;
        if (preg_match('/[零〇一二两三四五六七八九十百\d]+\s*倍\s*(?:组三|组六|复式)/u', $body) === 1) return null;

        $specs = [];
        preg_match_all('/(组三|组六|复式)\s*(?:各|每)\s*([零〇一二两三四五六七八九十百\d]+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?/u', $body, $amounts, PREG_SET_ORDER);
        preg_match_all('/(组三|组六|复式)\s*([零〇一二两三四五六七八九十百\d]+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)(?!\d)/u', $body, $amountsWithUnit, PREG_SET_ORDER);
        $amounts = array_merge($amounts, $amountsWithUnit);
        preg_match_all('/(组三|组六|复式)\s*([零〇一二两三四五六七八九十百\d]+)(?=\s*(?:组三|组六|复式|合计|共|计|$))/u', $body, $bareAmounts, PREG_SET_ORDER);
        $amounts = array_merge($amounts, $bareAmounts);
        $selectionSource = $body;
        foreach ($amounts as $amount) {
            $selectionSource = str_replace((string)$amount[0], ' ', $selectionSource);
            $value = $this->numericToken((string)$amount[2]);
            if ($value === null || $value <= 0) continue;
            $specs[(string)$amount[1]] = (string)($amount[3] ?? '') === '倍'
                ? $this->rules->multiplierAmount((string)$amount[1] === '复式' ? BetMultiplierAmount::COMPOUND : BetMultiplierAmount::GROUP_OTHER, $value)
                : $this->rules->amountWithUnit($value, (string)($amount[3] ?? ''), $unitStake);
        }
        if (count($specs) < $familyCount) {
            if (!preg_match('/((?:(?:组三|组六|复式)\s*){2,3})(?:各|每)\s*([零〇一二两三四五六七八九十百\d]+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?/u', $body, $shared)) {
                if (preg_match('/[零〇一二两三四五六七八九十百\d]+\s*倍\s*(?:组三|组六|复式)/u', $body) === 1) return null;
                $withoutTotal = preg_replace('/(?:合计|共计|总计|共|合|计)\s*[零〇一二两三四五六七八九十百\d]+(?:\.\d+)?\s*(?:元|米|块|角|毛)?\s*$/u', '', $body) ?? $body;
                if (!preg_match('/(?:各|每|打)?\s*([零〇一二两三四五六七八九十百\d]+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?\s*$/u', $withoutTotal, $tail)) return null;
                $tailValue = $this->numericToken((string)$tail[1]);
                if ($tailValue === null || $tailValue <= 0) return null;
                foreach ($familyNames as $family) $specs[$family] = (string)($tail[2] ?? '') === '倍'
                    ? $this->rules->multiplierAmount($family === '复式' ? BetMultiplierAmount::COMPOUND : BetMultiplierAmount::GROUP_OTHER, $tailValue)
                    : $this->rules->amountWithUnit($tailValue, (string)($tail[2] ?? ''), $unitStake);
                $shared = null;
            } else {
                $sharedValue = $this->numericToken((string)$shared[2]);
                if ($sharedValue === null || $sharedValue <= 0) return [$this->failure($source, '玩法金额格式不明确')];
                foreach ($familyNames as $family) $specs[$family] = (string)($shared[3] ?? '') === '倍'
                    ? $this->rules->multiplierAmount($family === '复式' ? BetMultiplierAmount::COMPOUND : BetMultiplierAmount::GROUP_OTHER, $sharedValue)
                    : $this->rules->amountWithUnit($sharedValue, (string)($shared[3] ?? ''), $unitStake);
            }
        }
        $selectionSource = preg_replace('/(?:各|每|打)\s*[零〇一二两三四五六七八九十百\d]+(?:\.\d+)?\s*(?:元|米|块|角|毛|倍|注)?/u', ' ', $selectionSource) ?? $selectionSource;
        $selectionSource = preg_replace('/[零〇一二两三四五六七八九十百\d]+(?:\.\d+)?\s*(?:元|米|块|角|毛|倍|注)\b/u', ' ', $selectionSource) ?? $selectionSource;
        $selectionSource = preg_replace('/组三|组六|复式/u', ' ', $selectionSource) ?? $selectionSource;
        $selectionSource = preg_replace('/[一二两三四五六七八九十\d]+码/u', ' ', $selectionSource) ?? $selectionSource;
        $selectionSource = preg_replace('/(?:合计|共计|总计|共|合|计)\s*\d+(?:\.\d+)?\s*(?:元|米|块|角|毛)?\s*$/u', ' ', $selectionSource) ?? $selectionSource;
        preg_match_all('/(?<!\d)(\d{2,10})(?!\d)/u', $selectionSource, $selections);
        $selected = array_values(array_unique($selections[1] ?? []));
        if (count($selected) < 1 || ($familyCount === 1 && count($selected) < 2)) return null;
        if ($familyCount === 1 && array_reduce($selected, static fn(bool $ok, string $value): bool => $ok && strlen($value) === 3, true)) return null;
        $categoryCount = $category === '福体' ? 2 : 1;
        $rows = [];
        foreach ($selected as $selection) {
            $digits = implode('', $this->unique(str_split($selection)));
            foreach ($specs as $family => $unitAmount) {
                $count = strlen($digits);
                if ($family === '组六' && $count < 3) return [$this->groupSixMultiCodeFailure($source)];
                if ($family === '组三' && $count < 2) return [$this->failure($source, '组三选号数量不足')];
                $play = ($count === 3 && in_array($family, ['组三', '组六'], true)) ? $family : $family.$this->countWord($count);
                $numbers = [$digits];
                if ($family === '组六' && $count >= 4) $numbers = $this->groupSixCombinations(str_split($digits));
                if ($family === '组三' && $count >= 3) $numbers = $this->groupThreeCombinations(str_split($digits));
                $row = $this->row($source, $body, $numbers, $category, $play, (float)$unitAmount * $categoryCount, $categoryCount, $categoryCount, '', 1);
                if (in_array($family, ['组三', '组六'], true) && $count > 3) {
                    $row['number_text'] = ($family === '组六' ? '六' : '三').$digits;
                    $row['display_number_text'] = $row['number_text'];
                    $row['settlement_text'] = $digits.' '.$play.' '.$category;
                    $row['expanded_number_text'] = implode(' ', $numbers);
                }
                $rows[] = $row;
            }
        }
        return $rows;
    }

    /** Parse a single explicit catalog entry such as “15862组六五码108元”. */
    private function compileCatalog(string $source, string $body, string $category, float $unitStake): ?array
    {
        $isCompact = false;
        if (!preg_match('/^(\d{2,10})\s*(组三|组六|复式)\s*([一二三四五六七八九1-9])码\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)
            && !preg_match('/^([一二三四五六七八九1-9])码\s*(组三|组六|复式)\s*(\d{2,10})\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)
            && !preg_match('/^(\d{2,10})\s*(组三|组六|复式)\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $compact)) return null;
        if (isset($compact)) {
            $isCompact = true;
            // Empty code marker means infer the code count from the unique
            // selection; retain that distinction for 复式's legacy display.
            $m = [$compact[0], $compact[1], $compact[2], '', $compact[3], $compact[4] ?? ''];
        }
        if (isset($m[3]) && preg_match('/^\d{2,10}$/', (string)$m[3]) === 1 && preg_match('/^[一二三四五六七八九1-9]$/u', (string)$m[1]) === 1) {
            [$m[1], $m[2], $m[3], $m[4], $m[5]] = [$m[3], $m[2], $m[1], $m[4], $m[5] ?? ''];
        }
        $selectionRaw = (string)$m[1];
        $selection = implode('', $this->unique(str_split($selectionRaw)));
        $family = (string)$m[2];
        $requested = $this->integerToken((string)$m[3]);
        if ($requested === null && $isCompact) $requested = strlen($selection);
        if ($isCompact && in_array($family, ['组三', '组六'], true) && strlen($selectionRaw) === 3) {
            $selection = $selectionRaw;
            $requested = 3;
        }
        if ($requested === null || strlen($selection) !== $requested) return [$this->failure($source, '所选数字数量与玩法不一致')];
        if ($family === '组六' && $requested < 3) return [$this->groupSixMultiCodeFailure($source)];
        if ($family === '组三' && $requested < 2) return [$this->failure($source, '组三选号数量不足')];
        $amount = (string)($m[5] ?? '') === '倍'
            ? $this->rules->multiplierAmount(
                $family === '复式' ? BetMultiplierAmount::COMPOUND : ($requested === 3 ? BetMultiplierAmount::LOTTERY_SINGLE : BetMultiplierAmount::GROUP_OTHER),
                (float)$m[4]
            )
            : $this->rules->amountWithUnit((float)$m[4], (string)($m[5] ?? ''), $unitStake);
        $categoryCount = $category === '福体' ? 2 : 1;
        $numbers = [$selection];
        if ($family === '组六' && $requested >= 4) $numbers = $this->groupSixCombinations(str_split($selection));
        if ($family === '组三' && $requested >= 3) $numbers = $this->groupThreeCombinations(str_split($selection));
        $standardThree = $family === '组三' && strlen($selectionRaw) === 3 && count(array_unique(str_split($selectionRaw))) === 2;
        $play = ($family === '组六' && $requested === 3) || $standardThree ? $family : $family.$this->countWord($requested);
        $row = $this->row($source, $body, $numbers, $category, $play, $amount*$categoryCount, $categoryCount, $categoryCount, '', 1);
        if (in_array($family, ['组三','组六'], true) && $requested > 3) {
            $row['number_text'] = ($family === '组六' ? '六' : '三').$selection;
            $row['display_number_text'] = $row['number_text'];
            $row['settlement_text'] = $selection.' '.$play.' '.$category;
            $row['expanded_number_text'] = implode(' ', $numbers);
        }
        if ($family === '复式' && $isCompact) {
            $row['number_text'] = (str_contains($body, '各') || str_contains($body, '每')) ? '000' : '复'.$selection;
            $row['display_number_text'] = '复'.$selection;
            $row['settlement_text'] = $selection.' '.$play.' '.$category;
        }
        return [$row];
    }

    /** Split a no-blank paste at explicit total markers and compile each ticket. */
    private function compileContinuousTickets(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = preg_split('/\r?\n/u', $source) ?: [];
        if (count($lines) < 2) return null;
        $hasTotal = false;
        foreach ($lines as $line) if (preg_match('/(?:合计|共计|总计|🈴|合)\s*\d/u', trim((string)$line)) === 1) { $hasTotal = true; break; }
        if (!$hasTotal) return null;
        $blocks = []; $current = [];
        foreach ($lines as $line) {
            $line = trim((string)$line);
            if ($line === '') continue;
            $current[] = $line;
            if (preg_match('/(?:合计|共计|总计|🈴|合)\s*\d/u', $line) === 1) {
                $blocks[] = implode("\n", $current); $current = [];
            }
        }
        if ($current !== []) $blocks[] = implode("\n", $current);
        if (count($blocks) < 2) return null;
        $rows = [];
        foreach ($blocks as $block) {
            $compiled = $this->compile($block, $lottery, $unitStake);
            if (!$compiled->matchedInput()) return null;
            $rows = array_merge($rows, $compiled->rows);
        }
        return $rows;
    }

    /** Parse “号码直2角福54注合10.8” as 54 stakes at 0.2元 each. */
    private function compileFuTiDeclaredDirect(string $source, string $body, float $unitStake): ?array
    {
        if (!preg_match('/^((?:\d{3}\s+)+\d{3})\s*一(?:共|合计)\s*(\d+)\s*注\s*(?:(?:福体\s*(?:直|单))|(?:(?:直|单)\s*福体))\s*各\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?\s*(?:合计|共计|总计|合|共|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u', $body, $m)) return null;
        $numbers = preg_split('/\s+/', trim($m[1]), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        $declaredCount = (int)$m[2];
        if ($numbers === [] || count($numbers) !== $declaredCount) return [$this->failure($source, '注数与号码数量不一致')];
        $unitAmount = $this->rules->amountWithUnit((float)$m[3], (string)($m[4] ?? ''), $unitStake);
        $actual = $declaredCount * $unitAmount * 2;
        $declared = $this->rules->amountWithUnit((float)$m[5], (string)($m[6] ?? ''), $unitStake);
        if (abs($actual - $declared) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
        $row = $this->row($source, $body, $numbers, '福体', '直', $actual, $declaredCount * 2, $declaredCount * 2, '直', 1);
        $row['settlement_text'] = implode(' ', $numbers).' 直各'.number_format($unitAmount, 2, '.', '').'元 福体';
        return [$row];
    }

    /** Parse “号码直2角福54注合10.8” as 54 stakes at 0.2元 each. */
    private function compileDeclaredCountAmount(string $source, string $body, string $category, float $unitStake): ?array
    {
        $body = preg_replace('/(?<=\d{3})\.+(?=\d{3})/u', ' ', $body) ?? $body;
        if (!preg_match('/^((?:\d{3}\s+)+\d{3})\s*(?:直|单)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)\s*(\d+)\s*注\s*(?:合计|共计|总计|合|共|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u', $body, $m)) return null;
        $numbers = preg_split('/\s+/', trim($m[1]), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        $declaredCount = (int)$m[4];
        if ($numbers === [] || $declaredCount !== count($numbers)) return [$this->failure($source, '注数与号码数量不一致')];
        $categoryCount = $category === '福体' ? 2 : 1;
        $unitAmount = $this->rules->amountWithUnit((float)$m[2], (string)$m[3], $unitStake);
        $amount = $unitAmount * $declaredCount * $categoryCount;
        $declared = $this->rules->amountWithUnit((float)$m[5], (string)($m[6] ?? ''), $unitStake);
        if (abs($amount - $declared) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
        return [$this->row($source, $body, $numbers, $category, '直', $amount, $declaredCount * $categoryCount, $declaredCount * $categoryCount, '直', 1)];
    }

    /** @return ?array<int,array<string,mixed>> */
    private function compileWrappedComposite(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r?\n/u', $source) ?: []), static fn(string $line): bool => $line !== ''));
        if (count($lines) < 2) return null;
        if (!preg_match('/^(?:福体|福|体)?\s*(?:沾边赖|粘边赖|占边赖|粘边|占边|连|連)?\s*(\d{1,10})\s*(?:沾边赖|粘边赖|占边赖|粘边|占边)?\s*(组三|组六)\s*(?:赖)?\s*(\d+(?:\.\d+)?)\s*(倍|注|元|米|块|角|毛)?$/u', $this->surface($lines[0]), $first)) return null;
        $selection = $first[1];
        $category = $this->category($this->surface($lines[0]), $lottery);
        $rows = [];
        foreach ($lines as $index => $line) {
            $normalized = $this->surface($line);
            if ($index === 0) {
                $family = $first[2]; $value = (float)$first[3]; $unit = (string)($first[4] ?? '');
            } elseif (!preg_match('/^(组三|组六)\s*(\d+(?:\.\d+)?)\s*(倍|注|元|米|块|角|毛)?$/u', $normalized, $next)) {
                return null;
            } else {
                $family = $next[1]; $value = (float)$next[2]; $unit = (string)($next[3] ?? '');
            }
            $compiled = $this->compileLianRows($source, $selection, $family, $value, $unit, $category, $unitStake);
            if ($compiled === null) return null;
            $rows = array_merge($rows, $compiled);
        }
        return $rows;
    }

    /** Parse 复式 with an optional companion 组三/组六 play. */
    private function compileComposite(string $source, string $body, string $category, float $unitStake): ?array
    {
        $match = null;
        if (preg_match('/^(\d{2,10})\s*复式\s*([一二三四五六七八九1-9])?码?\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)) {
            $match = ['selection'=>$m[1], 'families'=>['复式'], 'value'=>$m[3], 'unit'=>$m[4] ?? '', 'requested'=>$m[2] ?? ''];
        } elseif (preg_match('/^(\d{2,10})\s*(复式)\s*(组三|组六)\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)) {
            $match = ['selection'=>$m[1], 'families'=>['复式', $m[3]], 'value'=>$m[4], 'unit'=>$m[5] ?? '', 'requested'=>''];
        } elseif (preg_match('/^(\d{2,10})\s*(组三|组六)\s*(复式)\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)) {
            $match = ['selection'=>$m[1], 'families'=>[$m[2], '复式'], 'value'=>$m[4], 'unit'=>$m[5] ?? '', 'requested'=>''];
        } elseif (preg_match('/^(?:复式)\s*(组三|组六)\s*(\d{2,10})\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)) {
            $match = ['selection'=>$m[2], 'families'=>['复式', $m[1]], 'value'=>$m[3], 'unit'=>$m[4] ?? '', 'requested'=>''];
        }
        if ($match === null) return null;
        $digits = implode('', $this->unique((array)str_split((string)$match['selection'])));
        if ($digits === '') return [$this->failure($source, '复式选号不能为空')];
        if (($match['requested'] ?? '') !== '' && $this->integerToken((string)$match['requested']) !== strlen($digits)) return [$this->failure($source, '所选数字数量与复式码数不一致')];
        $categoryCount = $category === '福体' ? 2 : 1;
        $rows = [];
        foreach ($match['families'] as $family) {
            $amount = (string)$match['unit'] === '倍'
                ? $this->rules->multiplierAmount(
                    $family === '复式' ? BetMultiplierAmount::COMPOUND : (strlen($digits) === 3 ? BetMultiplierAmount::LOTTERY_SINGLE : BetMultiplierAmount::GROUP_OTHER),
                    (float)$match['value']
                )
                : $this->rules->amountWithUnit((float)$match['value'], (string)$match['unit'], $unitStake);
            if ($family === '复式') $play = '复式'.($this->countWord(strlen($digits)));
            else {
                if ($family === '组六' && strlen($digits) < 3) return [$this->groupSixMultiCodeFailure($source)];
                if ($family === '组三' && strlen($digits) < 2) return [$this->failure($source, '组三选号数量不足')];
                $play = $family.$this->countWord(strlen($digits));
            }
            $rowNumbers = [$digits];
            if ($family === '组六' && strlen($digits) >= 4) $rowNumbers = $this->groupSixCombinations(str_split($digits));
            if ($family === '组三' && strlen($digits) >= 3) $rowNumbers = $this->groupThreeCombinations(str_split($digits));
            $row = $this->row($source, $body, $rowNumbers, $category, $play, $amount * $categoryCount, $categoryCount, $categoryCount, '', 1);
            if ($family === '复式') {
                $row['number_text'] = ($match['requested'] ?? '') === '' ? '000' : '复'.$digits;
                $row['display_number_text'] = '复'.$digits;
                $row['settlement_text'] = $digits.' '.$play.' '.$category;
            }
            $rows[] = $row;
        }
        return $rows;
    }

    /** Parse 组三赖/组六赖 and the common “沾边赖/连” aliases. */
    private function compileLian(string $source, string $body, string $category, float $unitStake): ?array
    {
        $body = preg_replace('/(?:沾边赖|粘边赖|占边赖|粘边|占边|連|连)/u', '', $body) ?? $body;
        $surface = $this->surface($source);
        if (!preg_match('/赖|连|連|沾边|粘边|占边/u', $surface)) return null;
        if (substr_count($body, '组三') + substr_count($body, '组六') > 1) return null;
        if (!preg_match('/^(?:沾边赖\s*)?(\d{1,10})\s*(?:沾边赖\s*)?(组三|组六)\s*(?:赖)?\s*(?:(?:([一二三四五六七1-7])码)\s*)?(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(倍|注|元|米|块|角|毛)?$/u', $body, $m)) return null;
        $count = $m[3] !== '' ? $this->integerToken((string)$m[3]) : null;
        return $this->compileLianRows($source, (string)$m[1], (string)$m[2], (float)$m[4], (string)($m[5] ?? ''), $category, $unitStake, $count);
    }

    /** @return ?array<int,array<string,mixed>> */
    private function compileLianRows(string $source, string $selectionText, string $family, float $value, string $unit, string $category, float $unitStake, ?int $requestedCount = null): ?array
    {
        $selection = implode('', $this->unique(str_split($selectionText)));
        $count = $requestedCount ?? strlen($selection);
        if ($count !== strlen($selection)) return [$this->failure($source, '所选数字数量与赖玩法码数不一致')];
        $identity = $this->rules->catalogPlay($family.'赖', (string)$count);
        if ($identity === null) return [$this->failure($source, '所选数字数量与赖玩法不一致')];
        $base = $this->rules->baseStake($family === '组三' ? 'Z3' : 'Z6', $count);
        $multiplier = $unit === '倍' ? max(1.0, $value) : max(1.0, floor($this->rules->amountWithUnit($value, $unit, $unitStake) / $base + 1e-9));
        $categoryCount = $category === '福体' ? 2 : 1;
        $prefix = $family === '组三' ? '三赖' : '六赖';
        return [[
            'id'=>0, 'raw_text'=>$source, 'input_text'=>$source, 'parse_text'=>$selectionText.$family.$value.$unit, 'parser_version'=>'v2',
            'status'=>'success', 'reason'=>null, 'number_text'=>$prefix.$selection, 'display_number_text'=>$selection,
            'category'=>$category, 'amount'=>number_format($base*$multiplier*$categoryCount, 2, '.', ''), 'count'=>$categoryCount,
            'stake_count'=>$categoryCount, 'code_count'=>$categoryCount, 'play_type'=>$identity['name'],
            'settlement_text'=>$selection.' '.$identity['name'].' '.$category, 'amount_type'=>$unit === '倍' ? 'multiplier' : 'money',
            'multiplier'=>$multiplier, 'play_key'=>($family === '组三' ? 'Z3' : 'Z6').'_LIAN',
        ]];
    }

    /** Parse single/double banker drag, including shared 组三/组六 stakes. */
    private function compileSingleFullDrag(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match('/^(\d)\s*拖\s*(\d{2,9})\s*(?:单选全胆拖|全胆拖)\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(倍|注|元|米|块|角|毛)?$/u', $body, $m)) return null;
        $banker=(string)$m[1];$drags=implode('',array_values(array_diff($this->unique(str_split((string)$m[2])),[$banker])));$count=strlen($drags);
        if($count<2||$count>9)return [$this->failure($source,'单选全胆拖拖码数量不支持')];
        $value=(float)$m[3];$unit=(string)($m[4]??'');$categoryCount=$category==='福体'?2:1;
        $amount=$unit==='倍'?$this->rules->multiplierAmount(BetMultiplierAmount::SINGLE_FULL_DRAG,$value,$count):$this->rules->amountWithUnit($value,$unit,$unitStake);
        $row=$this->row($source,$body,[$banker.'拖'.$drags],$category,'1码拖'.$count,$amount*$categoryCount,$categoryCount,$categoryCount,'',1);
        $row['number_text']='胆'.$banker.'拖'.$drags;$row['display_number_text']=$row['number_text'];$row['settlement_text']='单选全胆拖 胆'.$banker.'拖'.$drags.' 1码拖'.$count.' '.$category;$row['amount_type']=$unit==='倍'?'multiplier':'money';$row['multiplier']=$unit==='倍'?$value:1.0;
        return [$row];
    }

    /** Parse single/double banker drag, including shared 组三/组六 stakes. */
    private function compileDrag(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!str_contains($body, '拖')) return null;
        if (str_contains($body, '胆') && !str_contains($body, '双胆') && !str_contains($body, '组三') && !str_contains($body, '组六')) {
            return [$this->failure($source, '胆拖玩法必须注明组三或组六')];
        }
        preg_match_all('/(?<!\d)(\d{1,2})\s*(?:胆)?\s*拖\s*(\d{2,9})(?!\d)/u', $body, $groupMatches, PREG_SET_ORDER);
        preg_match_all('/(?<!\d)(\d{1,2})\s*胆\s*(\d{2,9})\s*拖/u', $body, $splitGroups, PREG_SET_ORDER);
        foreach ($splitGroups as $split) $groupMatches[] = [$split[0], $split[1], $split[2]];
        if (($groupMatches ?? []) === []) return null;
        $families = [];
        preg_match_all('/组三|组六/u', $body, $familyMatches);
        foreach (array_values(array_unique($familyMatches[0] ?? [])) as $family) $families[] = $family;
        if ($families === []) $families = ['组六'];
        preg_match_all('/(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍|注)?(?=\s*$)/u', $body, $amountMatches, PREG_SET_ORDER);
        if ($amountMatches === [] && preg_match('/(\d+(?:\.\d+)?)\s*$/u', $body, $bareAmount)) {
            $amountMatches = [[$bareAmount[0], $bareAmount[1], '']];
        }
        if ($amountMatches === [] && preg_match('/([零〇一二两三四五六七八九十百]+)\s*(倍|注|元|米|块|角|毛)?\s*$/u', $body, $wordAmount)) {
            $wordValue = $this->numericToken((string)$wordAmount[1]);
            if ($wordValue !== null) $amountMatches = [[$wordAmount[0], (string)$wordValue, (string)($wordAmount[2] ?? '')]];
        }
        if ($amountMatches === []) return [$this->failure($source, '胆拖玩法或金额不明确')];
        $last = $amountMatches[array_key_last($amountMatches)];
        $categoryCount = $category === '福体' ? 2 : 1;
        $rows = [];
        foreach ($groupMatches as $group) {
            $bankers = implode('', $this->unique(str_split($group[1])));
            $drags = implode('', array_values(array_diff($this->unique(str_split($group[2])), str_split($bankers))));
            foreach ($families as $family) {
                $identity = $this->rules->dragPlay($family, strlen($bankers), strlen($drags));
                if ($identity === null) return [$this->failure($source, '胆码或拖码数量与玩法不一致')];
                $unitAmount = (string)($last[2] ?? '') === '倍'
                    ? $this->rules->multiplierAmount(
                        strlen($bankers) === 2 ? BetMultiplierAmount::GROUP_SIX_DOUBLE_DRAG : BetMultiplierAmount::GROUP_DRAG,
                        (float)$last[1],
                        strlen($drags)
                    )
                    : $this->rules->amountWithUnit((float)$last[1], (string)($last[2] ?? ''), $unitStake);
                $row = $this->row($source, $body, [$bankers.'拖'.$drags], $category, $identity['name'], $unitAmount*$categoryCount, $categoryCount, $categoryCount, '', 1);
                $row['number_text'] = '胆'.$bankers.'拖'.$drags;
                $row['display_number_text'] = '胆'.$bankers.'拖'.$drags;
                $row['settlement_text'] = $family.'胆拖 胆'.$bankers.'拖'.$drags.' '.$identity['name'].' '.$category;
                $rows[] = $row;
            }
        }
        return $rows;
    }

    /** Parse compact 百/十/个定位 sets with a shared amount and total. */
    private function compilePositionCompound(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match('/^(.*?)\s*(?:各|每)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍|注)?\s*(?:合计|共计|总计|合|共|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|快)?$/u', $body, $tail)) return null;
        $positionSource = trim((string)$tail[1]);
        preg_match_all('/(百|十|个)\s*(?:位)?\s*([0-9]+)/u', $positionSource, $matches, PREG_SET_ORDER);
        if (count($matches) < 1) return null;
        $positions = [];
        foreach ($matches as $match) {
            $position = (string)$match[1];
            if (isset($positions[$position])) return [$this->failure($source, '定位位置重复')];
            $positions[$position] = $this->unique(str_split((string)$match[2]));
        }
        $positionCount = count($positions);
        $explicitTwo = str_contains($body, '二定') || str_contains($body, '二码定位');
        if ($explicitTwo && $positionCount !== 2) return [$this->failure($source, '二定位必须包含两个不同位置')];
        if (!in_array($positionCount, [2, 3], true)) return [$this->failure($source, '定位玩法必须包含两个或三个不同位置')];
        $play = $positionCount === 2 ? '二码定位' : '三码定位';
        $count = 1;
        foreach ($positions as $digits) $count *= count($digits);
        $categoryCount = $category === '福体' ? 2 : 1;
        $unitAmount = $this->rules->amountWithUnit((float)$tail[2], (string)($tail[3] ?? ''), $unitStake);
        $calculated = $count * $unitAmount * $categoryCount;
        $declared = $this->rules->amountWithUnit((float)$tail[4], (string)($tail[5] ?? ''), $unitStake);
        if (abs($calculated - $declared) > 0.001) {
            $failure = $this->failure($source, '整张总金额与识别金额不一致');
            $failure['suggested_amount'] = number_format($calculated, 2, '.', '');
            return [$failure];
        }
        $display = [];
        foreach ($positions as $position => $digits) $display[] = $position.'位'.implode('', $digits);
        $row = $this->row($source, $body, ['000'], $category, $play, $calculated, $count * $categoryCount, $count * $categoryCount, '', 1);
        $row['number_text'] = implode(' ', $display);
        $row['display_number_text'] = $row['number_text'];
        $row['settlement_text'] = implode(' ', $display).' '.$play.'各'.number_format($unitAmount, 2, '.', '').'元 '.$category;
        return [$row];
    }

    /** Strict handlers for single-family plays that do not contain a number list. */
    private function compileSpecial(string $source, string $body, string $category, float $unitStake): ?array
    {
        $categoryCount = $category === '福体' ? 2 : 1;
        // A three-digit number followed directly by an amount is shorthand
        // for a direct bet. Accept forms with or without “各/共”: 
        // “111 100倍”, “111各100倍”, “111共100倍” and “111各100米”.
        if (preg_match('/^(\d{3}(?:\s+\d{3})*)\s*(?:(各|每|共|合计)\s*)?(\d+(?:\.\d+)?)\s*(倍|注|元|米|块|角|毛)$/u', $body, $implicitDirect)) {
            preg_match_all('/\d{3}/u', (string)$implicitDirect[1], $numberMatches);
            $numbers = array_values(array_unique($numberMatches[0] ?? []));
            $marker = (string)($implicitDirect[2] ?? '');
            $value = (float)$implicitDirect[3];
            $unit = (string)$implicitDirect[4];
            $perAmount = $unit === '倍'
                ? BetMultiplierAmount::DIRECT->oneMultiplier() * $value
                : $this->rules->amountWithUnit($value, $unit, $unitStake);
            $perNumber = $marker !== '共' && $marker !== '合计';
            $amount = $perAmount * ($perNumber ? count($numbers) : 1) * $categoryCount;
            $stakeCount = $unit === '倍' ? count($numbers) * (int)$value * $categoryCount : count($numbers) * $categoryCount;
            $row = $this->row($source, $body, $numbers, $category, '直', $amount, count($numbers) * $categoryCount, $stakeCount, '直', $unit === '倍' ? (int)$value : null);
            $row['amount_type'] = $unit === '倍' ? 'multiplier' : 'money';
            $row['multiplier'] = $unit === '倍' ? $value : 0.0;
            $row['settlement_text'] = implode(' ', $numbers).' 直'.($perNumber ? '各' : '合计').number_format($perAmount, 2, '.', '').'元 '.$category;
            return [$row];
        }
        if (preg_match('/^(?:独胆|胆)\s*([0-9])(?:\s*(?:各|每))?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?(?:\s*合计\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?)?$/u', $body, $m)) {
            $amount = $this->rules->amountWithUnit((float)$m[2], (string)($m[3] ?? ''), $unitStake) * $categoryCount;
            if (isset($m[4]) && $m[4] !== '') {
                $declared = $this->rules->amountWithUnit((float)$m[4], (string)($m[5] ?? ''), $unitStake);
                if (abs($declared - $amount) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
            }
            return [$this->row($source, $body, [$m[1]], $category, '独胆', $amount, $categoryCount, $categoryCount, '')];
        }
        if (preg_match('/^(?:独胆|胆)\s*([0-9])\s*[-~～]\s*([0-9])(?:\s*(?:各|每))?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?(?:\s*合计\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?)?$/u', $body, $m)) {
            // In shop notation “独胆2-8” lists two selected endpoint digits;
            // it does not mean every digit from 2 through 8.
            $digits = $this->unique([(string)$m[1], (string)$m[2]]);
            $unitAmount = $this->rules->amountWithUnit((float)$m[3], (string)($m[4] ?? ''), $unitStake);
            $amount = $unitAmount * count($digits) * $categoryCount;
            if (isset($m[5]) && $m[5] !== '') {
                $declared = $this->rules->amountWithUnit((float)$m[5], (string)($m[6] ?? ''), $unitStake);
                if (abs($declared - $amount) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
            }
            return [$this->row($source, $body, $digits, $category, '独胆', $amount, count($digits) * $categoryCount, count($digits) * $categoryCount, '')];
        }
        if (preg_match('/^(和大|和小|和单|和双|大|小|单|双)\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|注|倍)?$/u', $body, $m)) {
            $amount = ((string)($m[3] ?? '') === '倍' ? $this->rules->multiplierAmount(BetMultiplierAmount::SIZE_PARITY, (float)$m[2]) : $this->rules->amountWithUnit((float)$m[2], (string)($m[3] ?? ''), $unitStake)) * $categoryCount;
            return [$this->simpleRow($source, $body, $category, (string)$m[1], $amount, $categoryCount)];
        }
        if (preg_match('/^和值\s*(2[0-7]|1\d|\d)\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|注|倍)?$/u', $body, $m)) {
            $amount = ((string)($m[3] ?? '') === '倍' ? $this->rules->multiplierAmount(BetMultiplierAmount::SUM, (float)$m[2]) : $this->rules->amountWithUnit((float)$m[2], (string)($m[3] ?? ''), $unitStake)) * $categoryCount;
            return [$this->simpleRow($source, $body, $category, '和值'.$m[1], $amount, $categoryCount)];
        }
        if (preg_match('/^跨度\s*([0-9])\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|注|倍)?$/u', $body, $m)) {
            $amount = ((string)($m[3] ?? '') === '倍' ? $this->rules->multiplierAmount(BetMultiplierAmount::SPAN, (float)$m[2]) : $this->rules->amountWithUnit((float)$m[2], (string)($m[3] ?? ''), $unitStake)) * $categoryCount;
            return [$this->simpleRow($source, $body, $category, '跨度'.$m[1], $amount, $categoryCount)];
        }
        if (preg_match('/^(豹子全包|对子全包|组三全包|组六全包)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|注|倍)?$/u', $body, $m)) {
            $base = $m[1] === '豹子全包' ? BetMultiplierAmount::LEOPARD_PACKAGE : BetMultiplierAmount::PAIR_PACKAGE;
            $amount = ((string)($m[3] ?? '') === '倍' ? $this->rules->multiplierAmount($base, (float)$m[2]) : $this->rules->amountWithUnit((float)$m[2], (string)($m[3] ?? ''), $unitStake)) * $categoryCount;
            return [$this->simpleRow($source, $body, $category, (string)$m[1], $amount, $categoryCount)];
        }
        if (preg_match('/^(\d{2})\s*(双飞|飞|对子|对)\s*(?:各|每|值|各值|注值)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍|注)?$/u', $body, $m)) {
            $amount = $this->rules->amountWithUnit((float)$m[3], (string)($m[4] ?? ''), $unitStake) * $categoryCount;
            $play = in_array($m[2], ['对子', '对'], true) ? '对子' : '双飞';
            $row = $this->row($source, $body, [$m[1]], $category, $play, $amount, $categoryCount, $categoryCount, $play === '对子' ? '对' : '飞');
            $row['settlement_text'] = $m[1].' '.$play.' '.$category;
            return [$row];
        }
        if (preg_match('/^(组三|组六)?\s*(\d{1,2})\s*胆\s*(\d{2,9})\s*拖\s*(?:各|每)?\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?$/u', $body, $m)) {
            if (($m[1] ?? '') === '') return [$this->failure($source, '胆拖玩法必须注明组三或组六')];
            $bankers = $this->unique(str_split($m[2]));
            $drags = array_values(array_diff($this->unique(str_split($m[3])), $bankers));
            $identity = $this->rules->dragPlay((string)$m[1], count($bankers), count($drags));
            if ($identity === null) return [$this->failure($source, '胆码或拖码数量与玩法不一致')];
            $amount = ((string)($m[5] ?? '') === '倍' ? $this->rules->multiplierAmount(count($bankers) === 2 ? BetMultiplierAmount::GROUP_SIX_DOUBLE_DRAG : BetMultiplierAmount::GROUP_DRAG, (float)$m[4], count($drags)) : $this->rules->amountWithUnit((float)$m[4], (string)($m[5] ?? ''), $unitStake)) * $categoryCount;
            return [$this->row($source, $body, [$m[2].'拖'.$m[3]], $category, $identity['name'], $amount, $categoryCount, $categoryCount, '')];
        }
        if (preg_match('/^(?:百\s*([0-9]+)\s*)?(?:十\s*([0-9]+)\s*)?(?:个\s*([0-9]+)\s*)+(?:各|每)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍|注)?$/u', $body, $m)) {
            $sets = array_values(array_filter([$m[1] ?? '', $m[2] ?? '', $m[3] ?? ''], static fn(string $v): bool => $v !== ''));
            if ($sets !== []) {
                $count = 1; foreach ($sets as $set) $count *= strlen($set);
                $amount = $this->rules->amountWithUnit((float)$m[4], (string)($m[5] ?? ''), $unitStake) * $count * $categoryCount;
                $markerCount = 0;
                foreach (['百','十','个'] as $marker) if (str_contains($body, $marker)) $markerCount++;
                $play = $markerCount >= 3 ? '三码定位' : ($markerCount === 2 ? '二码定位' : '一码定位');
                $row = $this->row($source, $body, $sets, $category, $play, $amount, $count * $categoryCount, $count * $categoryCount, '');
                $positionText = preg_replace('/\s*(?:各|每)\s*[0-9.]+\s*(?:元|米|块|角|毛|倍|注)\s*$/u', '', $body) ?? $body;
                $row['number_text'] = $positionText;
                $row['display_number_text'] = $positionText;
                $row['settlement_text'] = $positionText.' '.$play.'各'.number_format($this->rules->amountWithUnit((float)$m[4], (string)($m[5] ?? ''), $unitStake), 2, '.', '').'元 '.$category;
                return [$row];
            }
        }
        return null;
    }

    private function simpleRow(string $source, string $body, string $category, string $play, float $amount, int $count): array
    {
        return ['id'=>0,'raw_text'=>$source,'input_text'=>$source,'parse_text'=>$body,'parser_version'=>'v2','status'=>'success','reason'=>null,'number_text'=>'','display_number_text'=>'','category'=>$category,'amount'=>number_format($amount,2,'.',''),'count'=>$count,'stake_count'=>$count,'code_count'=>$count,'play_type'=>$play,'settlement_text'=>$play.' '.$category,'amount_type'=>'money'];
    }

    /** Parse a multi-digit selection with separate 组六/组三 amounts. */
    private function compileSelectionGroups(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match('/^(\d{2,10})\s*(?:各\s*)?(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?\s*组六\s*(?:各\s*)?(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?\s*组三\s*(?:共计|合计|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u', $body, $match)) return null;
        $digits = $this->unique(str_split($match[1]));
        if (count($digits) < 3) return [$this->failure($source, '组六选号数量不足')];
        $six = $this->groupSixCombinations($digits);
        $three = $this->groupThreeCombinations($digits);
        $categoryCount = $category === '福体' ? 2 : 1;
        $sixAmount = $this->rules->amountWithUnit((float)$match[2], (string)($match[3] ?? ''), $unitStake) * $categoryCount;
        $threeAmount = $this->rules->amountWithUnit((float)$match[4], (string)($match[5] ?? ''), $unitStake) * $categoryCount;
        $declared = $this->rules->amountWithUnit((float)$match[6], (string)($match[7] ?? ''), $unitStake) * $categoryCount;
        if (abs($declared - $sixAmount - $threeAmount) > 0.001) return [$this->failure($source, '句末总金额与玩法金额不一致')];
        return [
            $this->groupSelectionRow($source, $body, $six, $category, '组六'.$this->countWord(count($digits)), $sixAmount),
            $this->groupSelectionRow($source, $body, $three, $category, '组三'.$this->countWord(count($digits)), $threeAmount),
        ];
    }

    /** @param array<int,string> $digits @return array<int,string> */
    private function groupSixCombinations(array $digits): array
    {
        $result = [];
        for ($i = 0; $i < count($digits) - 2; $i++) for ($j = $i + 1; $j < count($digits) - 1; $j++) for ($k = $j + 1; $k < count($digits); $k++) $result[] = $digits[$i].$digits[$j].$digits[$k];
        return $result;
    }

    /** @param array<int,string> $digits @return array<int,string> */
    private function groupThreeCombinations(array $digits): array
    {
        $result = [];
        for ($i = 0; $i < count($digits); $i++) for ($j = 0; $j < count($digits); $j++) if ($i !== $j) $result[] = $digits[$i].$digits[$i].$digits[$j];
        return $result;
    }

    /** @param array<int,string> $numbers */
    private function groupSelectionRow(string $source, string $body, array $numbers, string $category, string $play, float $amount): array
    {
        $categoryCount = $category === '福体' ? 2 : 1;
        return [
            'id'=>0, 'raw_text'=>$source, 'input_text'=>$source, 'parse_text'=>$body, 'parser_version'=>'v2',
            'status'=>'success', 'reason'=>null, 'number_text'=>implode(' ', $numbers),
            'display_number_text'=>implode(' ', $numbers), 'category'=>$category,
            'amount'=>number_format($amount, 2, '.', ''), 'count'=>$categoryCount,
            'stake_count'=>$categoryCount, 'code_count'=>$categoryCount, 'play_type'=>$play,
            'settlement_text'=>implode(' ', $numbers).' '.$play.' '.$category, 'amount_type'=>'money',
        ];
    }

    private function countWord(int $count): string
    {
        return match ($count) { 2=>'两码', 3=>'三码', 4=>'四码', 5=>'五码', 6=>'六码', 7=>'七码', 8=>'八码', 9=>'八码', 10=>'全包', default=>$count.'码' };
    }

    /** Parse wrapped number lines with a shared “50倍单50组共计2200元” suffix. */
    private function compileWrappedDirectGroup(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match('/^(\d{3}(?:\s+\d{3})*)\s*(\d+)倍\s*(?:单|直)\s*(\d+)\s*组\s*(?:共计|共|合计|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u', $body, $match)) return null;
        $numbers = preg_split('/\s+/u', trim($match[1]), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        $categoryCount = $category === '福体' ? 2 : 1;
        $directAmount = count($numbers) * (int)$match[2] * $unitStake * $categoryCount;
        $groupAmount = count($numbers) * (int)$match[3] * $unitStake * $categoryCount;
        $declared = $this->rules->amountWithUnit((float)$match[4], (string)($match[5] ?? ''), $unitStake) * $categoryCount;
        if (abs($declared - $directAmount - $groupAmount) > 0.001) return [$this->failure($source, '句末总金额与单双组倍数不一致')];
        $unique = $this->unique($numbers);
        return [
            $this->row($source, $body, $unique, $category, '直', $directAmount, count($unique) * $categoryCount, count($numbers) * (int)$match[2] * $categoryCount, '直', (int)$match[2]),
            $this->row($source, $body, $unique, $category, '组六', $groupAmount, count($unique) * $categoryCount, count($numbers) * (int)$match[3] * $categoryCount, '组', (int)$match[3]),
        ];
    }

    /** Parse e.g. “571 574 579 570四十倍直十倍组共400元”. */
    private function compileMixedDirectGroup(string $source, string $body, string $category, float $unitStake): ?array
    {
        $match = null;
        if (preg_match(
            '/^(\d{3}(?:\s+\d{3})*)\s*([零〇一二两三四五六七八九十\d]+)\s*倍\s*(?:直|单)\s*([零〇一二两三四五六七八九十\d]+)\s*倍\s*(?:组|组六)\s*(?:共计|共|合计|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u',
            $body,
            $candidate
        )) {
            $match = $candidate;
        } elseif (preg_match(
            '/^(\d{3}(?:\s+\d{3})*)\s*([零〇一二两三四五六七八九十\d]+)\s*倍\s*(?:直|单)\s*([零〇一二两三四五六七八九十\d]+)\s*(?:组|组六)\s*(?:共计|共|合计|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u',
            $body,
            $candidate
        )) {
            $match = $candidate;
        }
        if ($match === null) return null;
        $directMultiplier = $this->integerToken($match[2]);
        $groupMultiplier = $this->integerToken($match[3]);
        if ($directMultiplier === null || $groupMultiplier === null) return [$this->failure($source, '单双组倍数格式不明确')];
        $numbers = preg_split('/\s+/u', trim($match[1]), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        $categoryCount = $category === '福体' ? 2 : 1;
        $directAmount = count($numbers) * $directMultiplier * $unitStake * $categoryCount;
        $groupAmount = count($numbers) * $groupMultiplier * $unitStake * $categoryCount;
        $declared = $this->rules->amountWithUnit((float)$match[4], (string)($match[5] ?? ''), $unitStake) * $categoryCount;
        if (abs($declared - $directAmount - $groupAmount) > 0.001) return [$this->failure($source, '句末总金额与单双组倍数不一致')];
        $unique = $this->unique($numbers);
        return [
            $this->row($source, $body, $unique, $category, '直', $directAmount, count($unique) * $categoryCount, count($numbers) * $directMultiplier * $categoryCount, '直', $directMultiplier),
            $this->row($source, $body, $unique, $category, '组六', $groupAmount, count($unique) * $categoryCount, count($numbers) * $groupMultiplier * $categoryCount, '组', $groupMultiplier),
        ];
    }

    /** @return ?array<int,array<string,mixed>> */
    private function compileListedCountedDirectGroup(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match(
            '/^(\d{3}(?:\s+\d{3})*)\s*(?:各\s*)?([零〇一二两三四五六七八九十百\d]+)\s*(?:单|直)\s*([零〇一二两三四五六七八九十百\d]+)\s*(?:组|组六)(?:\s*(?:(?:计|合计|共)\s*)?(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?)?$/u',
            $body,
            $match
        )) return null;

        $directStakes = $this->integerToken($match[2]);
        $groupStakes = $this->integerToken($match[3]);
        if ($directStakes === null || $groupStakes === null) {
            return [$this->failure($source, str_contains($match[2].$match[3], '百')
                ? '单双组倍数格式不支持中文百位数，请使用数字格式（如400单1组）'
                : '单双组倍数格式不明确，请使用数字或一至九十九的中文数字')];
        }
        if ($directStakes < 1 || $groupStakes < 1) return [$this->failure($source, '单双组倍数必须大于0')];

        $numbers = preg_split('/\s+/u', trim($match[1]), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        $categoryCount = $category === '福体' ? 2 : 1;
        $directAmount = count($numbers) * $directStakes * $unitStake * $categoryCount;
        $groupAmount = count($numbers) * $groupStakes * $unitStake * $categoryCount;
        if (($match[4] ?? '') !== '') {
            $declared = $this->rules->amountWithUnit((float)$match[4], (string)($match[5] ?? ''), $unitStake) * $categoryCount;
            if (abs($declared - $directAmount - $groupAmount) > 0.001) {
                return [$this->failure($source, '句末总金额与单双组倍数不一致')];
            }
        }

        // Preserve each entered code.  A listed counted ticket charges every
        // occurrence, and permutations (for example 849/948) are distinct
        // selectable codes even though they share an unordered group set.
        $displayNumbers = $numbers;
        $rows = [$this->row(
            $source,
            $body,
            $displayNumbers,
            $category,
            '直',
            $directAmount,
            count($displayNumbers) * $categoryCount,
            count($numbers) * $directStakes * $categoryCount,
            '直',
            $directStakes
        )];
        foreach ($this->groupedNumbers($numbers, '组') as $groupPlay => $groupNumbers) {
            $occurrenceCount = count($groupNumbers);
            $displayGroupNumbers = $groupNumbers;
            $rows[] = $this->row(
                $source,
                $body,
                $displayGroupNumbers,
                $category,
                $groupPlay,
                $occurrenceCount * $groupStakes * $unitStake * $categoryCount,
                count($displayGroupNumbers) * $categoryCount,
                $occurrenceCount * $groupStakes * $categoryCount,
                '组',
                $groupStakes
            );
        }
        return $rows;
    }

    /** @return ?array<int,array<string,mixed>> */
    private function compileCountedDirectGroup(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match(
            '/^([0-9]{1,10})\s*([零〇一二两三四五六七八九十百\d]+)\s*(?:单|直)\s*([零〇一二两三四五六七八九十百\d]+)\s*(?:组|组六)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?$/u',
            $body,
            $match
        )) return null;

        $directStakes = $this->integerToken($match[2]);
        $groupStakes = $this->integerToken($match[3]);
        if ($directStakes === null || $groupStakes === null) {
            return [$this->failure($source, '单双组倍数格式不明确，请使用数字或一至九十九的中文数字')];
        }
        if ($directStakes < 1 || $groupStakes < 1) {
            return [$this->failure($source, '单双组倍数必须大于0')];
        }

        $selection = $match[1];
        $categoryCount = $category === '福体' ? 2 : 1;
        $perStake = strlen($selection) === 3 ? $unitStake : 10.0;
        $directAmount = $directStakes * $perStake * $categoryCount;
        $groupAmount = $groupStakes * $perStake * $categoryCount;
        $declared = $this->rules->amountWithUnit((float)$match[4], (string)($match[5] ?? ''), $unitStake) * $categoryCount;
        if (abs($declared - $directAmount - $groupAmount) > 0.001) {
            return [$this->failure($source, '句末总金额与单双组倍数不一致')];
        }

        return [
            $this->row($source, $body, [$selection], $category, '直', $directAmount, $categoryCount, $directStakes * $categoryCount, '直', $directStakes),
            $this->row($source, $body, [$selection], $category, '组六', $groupAmount, $categoryCount, $groupStakes * $categoryCount, '组', $groupStakes),
        ];
    }

    /** @return ?array<int,array<string,mixed>> */
    private function compileExplicitNumberList(string $source, string $body, string $category, float $unitStake): ?array
    {
        $body = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $body) ?? $body;
        [$working, $declaredTotal] = $this->takeDeclaredTotal($body, $unitStake);
        $numberList = '(\d{3}(?:\s+\d{3})*)';
        $play = '(直组|组直|直选|直|单|组三|组六|组)';
        $amount = '(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|倍)?';
        $match = null;
        $playFirst = false;

        if (preg_match('/^'.$numberList.'\s*'.$play.'\s*(?:各|每)?\s*'.$amount.'$/u', $working, $candidate)) {
            $match = ['numbers'=>$candidate[1], 'play'=>$candidate[2], 'value'=>$candidate[3], 'unit'=>$candidate[4] ?? ''];
        } elseif (preg_match('/^'.$play.'\s*(?:各|每)?\s*'.$amount.'\s*'.$numberList.'$/u', $working, $candidate)) {
            $playFirst = true;
            $match = ['numbers'=>$candidate[4], 'play'=>$candidate[1], 'value'=>$candidate[2], 'unit'=>$candidate[3] ?? ''];
        } elseif (preg_match('/^'.$play.'\s*'.$numberList.'\s*(?:各|每)?\s*'.$amount.'$/u', $working, $candidate)) {
            $playFirst = true;
            $match = ['numbers'=>$candidate[2], 'play'=>$candidate[1], 'value'=>$candidate[3], 'unit'=>$candidate[4] ?? ''];
        } elseif (preg_match('/^'.$play.'\s*'.$amount.'\s*'.$numberList.'$/u', $working, $candidate)) {
            $playFirst = true;
            $match = ['numbers'=>$candidate[4], 'play'=>$candidate[1], 'value'=>$candidate[2], 'unit'=>$candidate[3] ?? ''];
        }
        if ($match === null) return null;

        $numbers = preg_split('/\s+/u', trim((string)$match['numbers']), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        if ($numbers === [] || count($numbers) > QuickEntryRules::MAX_NUMBERS_PER_LINE) {
            return [$this->failure($source, $numbers === [] ? '未识别到有效号码' : '单行号码数量超过限制')];
        }
        // A play-first sentence is intentionally accepted only because all
        // remaining tokens are exact three-digit selections. This prevents
        // the final selection from being consumed as a stake count.
        if ($playFirst && count(array_filter($numbers, static fn(string $n): bool => strlen($n) === 3)) !== count($numbers)) {
            return [$this->failure($source, '玩法后的号码格式不明确')];
        }

        $unitAmount = $this->rules->amountWithUnit((float)$match['value'], (string)$match['unit'], $unitStake);
        $categoryCount = $category === '福体' ? 2 : 1;
        $plays = in_array($match['play'], ['直组', '组直'], true) ? ['直', '组'] : [$match['play'] === '单' || $match['play'] === '直选' ? '直' : $match['play']];
        $rows = [];
        foreach ($plays as $selectedPlay) {
            if ($selectedPlay === '直') {
                $unique = $this->unique($numbers);
                $rows[] = $this->row(
                    $source,
                    $body,
                    $unique,
                    $category,
                    '直',
                    count($numbers) * $unitAmount * $categoryCount,
                    count($unique) * $categoryCount,
                    count($numbers) * $categoryCount,
                    '直'
                );
                continue;
            }
            foreach ($this->groupedNumbers($numbers, $selectedPlay) as $groupPlay => $groupNumbers) {
                $occurrences = count($groupNumbers);
                $displayNumbers = $this->uniqueUnordered($groupNumbers);
                $rows[] = $this->row(
                    $source,
                    $body,
                    $displayNumbers,
                    $category,
                    $groupPlay,
                    $occurrences * $unitAmount * $categoryCount,
                    count($displayNumbers) * $categoryCount,
                    $occurrences * $categoryCount,
                    '组'
                );
            }
        }
        if ($rows === []) return [$this->failure($source, '号码形态与玩法不一致')];

        if ($declaredTotal !== null) {
            $calculated = array_sum(array_map(static fn(array $row): float => (float)$row['amount'], $rows));
            // takeDeclaredTotal() already converts the declared amount once;
            // calculated rows include the 福体 category multiplier, so do not
            // multiply the declared total a second time.
            if (abs($declaredTotal - $calculated) > 0.001) {
                return [$this->failure($source, '整张总金额与识别金额不一致')];
            }
        }
        return $rows;
    }

    /** @return array{0:string,1:?float} */
    private function takeDeclaredTotal(string $body, float $unitStake): array
    {
        if (!preg_match('/\s*(?:合计|共计|总计|共|合|计)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?\s*$/u', $body, $match, PREG_OFFSET_CAPTURE)) {
            return [$body, null];
        }
        $offset = (int)$match[0][1];
        $total = $this->rules->amountWithUnit((float)$match[1][0], (string)($match[2][0] ?? ''), $unitStake);
        return [trim(substr($body, 0, $offset)), $total];
    }

    /** @param array<int,string> $numbers @return array<string,array<int,string>> */
    private function groupedNumbers(array $numbers, string $requestedPlay): array
    {
        $groups = [];
        foreach ($numbers as $number) {
            $uniqueDigits = count(array_unique(str_split($number)));
            $actual = $requestedPlay;
            if ($requestedPlay === '组') $actual = $uniqueDigits === 2 ? '组三' : ($uniqueDigits === 3 ? '组六' : '');
            if ($requestedPlay === '组三' && $uniqueDigits !== 2) continue;
            if ($requestedPlay === '组六' && $uniqueDigits !== 3) continue;
            if ($actual === '') continue;
            // Keep repeated occurrences for stake accounting. Two numbers
            // that share the same unordered digit set (e.g. 965 and 956)
            // are still two separate selections in a 直组 ticket.
            $groups[$actual][] = $number;
        }
        return $groups;
    }

    /** @param array<int,string> $numbers */
    private function row(
        string $source,
        string $normalized,
        array $numbers,
        string $category,
        string $play,
        float $amount,
        int $count,
        int $stakeCount,
        string $suffix,
        ?int $betCount = null,
    ): array {
        $display = implode(' ', $numbers);
        $numberText = implode(' ', array_map(static fn(string $number): string => $number.$suffix, $numbers));
        $unitAmount = $stakeCount > 0 ? $amount / $stakeCount : 0.0;
        $row = [
            'id'=>0,
            'raw_text'=>$source,
            'input_text'=>$source,
            'parse_text'=>$normalized,
            'parser_version'=>'v2',
            'status'=>'success',
            'reason'=>null,
            'number_text'=>$numberText,
            'display_number_text'=>$display,
            'category'=>$category,
            'amount'=>number_format($amount, 2, '.', ''),
            'count'=>$count,
            'stake_count'=>$stakeCount,
            'code_count'=>$count,
            'play_type'=>$play,
            'settlement_text'=>$display.' '.$play.'各'.number_format($unitAmount, 2, '.', '').'元 '.$category,
            'amount_type'=>'money',
        ];
        if ($betCount !== null) $row['bet_count'] = $betCount;
        return $row;
    }

    private function groupSixMultiCodeFailure(string $source): array
    {
        return $this->failure($source, [
            '检测到组六多码的数字数量没有在规定范围内（四码 ~ 九码）',
            '未检测到可识别的号码，请检查语句',
        ]);
    }

    private function failure(string $source, string|array $reason): array
    {
        $reasons = is_array($reason) ? array_values(array_filter(array_map(static fn(mixed $value): string => trim((string)$value), $reason), static fn(string $value): bool => $value !== '')) : [trim($reason)];
        if ($reasons === []) $reasons = ['语句存在问题，无法识别'];
        return [
            'id'=>0,
            'raw_text'=>$source,
            'input_text'=>$source,
            'parse_text'=>$this->surface($source),
            'parser_version'=>'v2',
            'status'=>'failed',
            'reason'=>implode('；', $reasons),
            'reasons'=>$reasons,
            'number_text'=>'',
            'category'=>null,
            'amount'=>'0.00',
            'count'=>0,
            'stake_count'=>0,
            'code_count'=>0,
        ];
    }

    private function surface(string $source): string
    {
        $source = preg_replace('/[\x{FE0E}\x{FE0F}]/u', '', $source) ?? $source;
        // Canonicalize all commonly used total markers before parsing. The
        // single-character “和” is only treated as a total marker when it is
        // followed by a numeric amount, so “和值/和大/和小” remain plays.
        $source = preg_replace('/(?:小计|小計|结算|結算|总共|總共|总和|總和|总额|總額|总数|總數|总合|總合|总计|總計|共计|共計|合共|共合|合计|合計)/u', '合计', $source) ?? $source;
        $source = preg_replace('/(?:和|共|合|结|总|(?<!合)计)(?=\s*[0-9零〇一二两三四五六七八九十百])/u', '合计', $source) ?? $source;
        $source = strtr($source, [
            '福彩'=>'福', '体彩'=>'体', '排列三'=>'体', '排三'=>'体', '褔'=>'福',
            '直选'=>'直', '复试'=>'复式', '複式'=>'复式', '快'=>'块',
            '共計'=>'共计', '總計'=>'总计', '🈴'=>'合',
            '，'=>' ', ','=>' ', '、'=>' ', '。'=>' ', ';'=>' ', '；'=>' ', ':'=>' ', '：'=>' ',
            '/'=>' ', '／'=>' ', '|'=>' ', '·'=>' ', '—'=>' ', '－'=>' ', '_'=>' ',
            '['=>' ', ']'=>' ', '［'=>' ', '］'=>' ',
        ]);
        // Punctuation may have separated a one-character total marker from
        // its amount (e.g. “和，12元”); normalize that form after punctuation
        // folding as well. Existing “和值/和大/和小” remain untouched.
        $source = preg_replace('/(?:和|共|合|结|总|(?<!合)计)(?=\s*[0-9零〇一二两三四五六七八九十百])/u', '合计', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z])F(?![A-Za-z])/iu', '福', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z])T(?![A-Za-z])/iu', '体', $source) ?? $source;
        $source = preg_replace('/(?<!全)托码?/u', '拖', $source) ?? $source;
        $source = preg_replace('/(?<!全)托(?!码)/u', '拖', $source) ?? $source;
        $source = preg_replace('/Z\s*6/iu', '组六', $source) ?? $source;
        $source = preg_replace('/Z\s*3/iu', '组三', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z0-9])H\s*(2[0-7]|1\d|\d)(?![A-Za-z0-9])/iu', '和值$1', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z0-9])K\s*([0-9])(?![A-Za-z0-9])/iu', '跨度$1', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z0-9])B\s*([0-9])(?![A-Za-z0-9])/iu', '百$1', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z0-9])S\s*([0-9])(?![A-Za-z0-9])/iu', '十$1', $source) ?? $source;
        $source = preg_replace('/(?<![A-Za-z0-9])G\s*([0-9])(?![A-Za-z0-9])/iu', '个$1', $source) ?? $source;
        $source = preg_replace('/(组三|组六|豹子|对子)\s*包(?!选)/u', '$1全包', $source) ?? $source;
        $source = preg_replace('/[-—－]+(?=\s|$)/u', ' ', $source) ?? $source;
        // ASCII dots are commonly used as number separators (794..974), not
        // decimals, when both sides are three-digit selections.
        $source = preg_replace('/(?<=\d{3})\.+(?=\d{3})/u', ' ', $source) ?? $source;
        $source = preg_replace_callback('/(?<![0-9零〇一二两三四五六七八九十百])([零〇一二两三四五六七八九十百]+)(?=\s*(?:元|米|块|角|毛|倍|注))/u', function (array $match): string {
            $value = $this->numericToken((string)$match[1]);
            return $value === null ? $match[1] : (string)$value;
        }, $source) ?? $source;
        $source = preg_replace('/组6(?!\d)/u', '组六', $source) ?? $source;
        $source = preg_replace('/组3(?!\d)/u', '组三', $source) ?? $source;
        $source = preg_replace('/\s+/u', ' ', $source) ?? $source;
        return trim($source);
    }

    private function category(string $source, string $fallback): string
    {
        $fu = str_contains($source, '福');
        $ti = str_contains($source, '体');
        if ($fu && $ti) return '福体';
        if ($fu) return '福';
        if ($ti) return '体';
        return $fallback === '排列三' ? '体' : '福';
    }

    private function integerToken(string $token): ?int
    {
        if (ctype_digit($token)) return (int)$token;
        $digits = ['零'=>0, '〇'=>0, '一'=>1, '二'=>2, '两'=>2, '三'=>3, '四'=>4, '五'=>5, '六'=>6, '七'=>7, '八'=>8, '九'=>9];
        if (str_contains($token, '百')) return null;
        if (str_contains($token, '十')) {
            [$left, $right] = array_pad(explode('十', $token, 2), 2, '');
            $tens = $left === '' ? 1 : ($digits[$left] ?? null);
            $ones = $right === '' ? 0 : ($digits[$right] ?? null);
            return $tens === null || $ones === null ? null : $tens * 10 + $ones;
        }
        return $digits[$token] ?? null;
    }

    private function numericToken(string $token): ?float
    {
        if (preg_match('/^\d+(?:\.\d+)?$/', $token) === 1) return (float)$token;
        if (str_contains($token, '.')) return null;
        $integer = $this->integerToken($token);
        return $integer === null ? null : (float)$integer;
    }

    /** @param array<int,string> $values @return array<int,string> */
    private function unique(array $values): array
    {
        $result = [];
        foreach ($values as $value) if (!in_array($value, $result, true)) $result[] = $value;
        return $result;
    }

    /** Keep one display token per unordered group while preserving stake count. */
    private function uniqueUnordered(array $values): array
    {
        $result = []; $seen = [];
        foreach ($values as $value) {
            $digits = str_split($value); sort($digits); $key = implode('', $digits);
            if (isset($seen[$key])) continue;
            $seen[$key] = true; $result[] = $value;
        }
        return $result;
    }
}
