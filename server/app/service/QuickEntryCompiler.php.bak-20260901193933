        }
        if ($numbers === []) return null;
        if (($h[5] ?? '') !== '' && (int)$h[5] !== count($numbers)) return [$this->failure($source, '注数与号码数量不一致')];
        $category = (string)$h[1];
        $categoryCount = $category === '福体' ? 2 : 1;
        $unitAmount = $this->rules->amountWithUnit((float)$h[3], (string)$h[4], $unitStake);
        $rows = [$this->row($source, implode(' ', $numbers).'直组', array_values(array_unique($numbers)), $category, '直', count($numbers) * $unitAmount * $categoryCount, count(array_unique($numbers)) * $categoryCount, count($numbers) * $categoryCount, '直', 1)];
