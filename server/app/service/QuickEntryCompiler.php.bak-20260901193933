        $declared = $this->rules->amountWithUnit((float)$m[4], (string)($m[5] ?? ''), $unitStake);
        $actual = count($numbers) * $unitAmount * 2 * $categoryCount;
        if (abs($declared - $actual) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
        $rows = [$this->row($source, $body, array_values(array_unique($numbers)), $category, '直', count($numbers) * $unitAmount * $categoryCount, count(array_unique($numbers)) * $categoryCount, count($numbers) * $categoryCount, '直', 1)];
