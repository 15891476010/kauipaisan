        }
        if ($numbers === [] || $playLines === []) return null;
        // Preserve duplicate occurrences for direct/group stake accounting;
        // display-layer handlers may still collapse unordered group tokens.
        $joinedNumbers = implode(' ', $numbers);
        $rows = [];
        foreach ($playLines as $playLine) {
            $parsed = $this->compile($joinedNumbers.' '.$playLine, $lottery, $unitStake);
            if (!$parsed->matchedInput()) return null;
