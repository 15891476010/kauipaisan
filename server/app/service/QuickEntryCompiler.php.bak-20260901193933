        return $rows;
    }

    /** Compile number lines followed by independent play/amount lines. */
    private function compileMultilinePlayLines(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r?\n/u', $source) ?: []), static fn(string $line): bool => $line !== ''));
        if (count($lines) < 2) return null;
        $numbers = [];
        $playLines = [];
        foreach ($lines as $line) {
            $normalized = $this->surface($line);
            $normalizedNumbers = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $normalized) ?? $normalized;
            if (preg_match('/^(?:\d{3}(?:\s+\d{3})*|\d{2,10})$/u', $normalizedNumbers) === 1) {
                preg_match_all('/\d{3}/u', $normalizedNumbers, $matches);
                $numbers = array_merge($numbers, $matches[0] ?? []);
                continue;
            }
            if (preg_match('/^(?:福体|福|体)?\s*(?:直|单|组|组三|组六|直组|组直)\s*(?:各|每)?\s*[一二两三四五六七八九十\d]+(?:\.\d+)?\s*(?:元|米|块|角|毛|倍|注)?$/u', $normalized) === 1) {
                $playLines[] = $normalized;
                continue;
            }
