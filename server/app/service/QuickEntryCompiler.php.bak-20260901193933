            if ($remainingOperands >= count($blockRows) && $remainingOperands > 1) {
                foreach ($blockRows as $row) {
                    $row['amount'] = number_format((float)$operands[$operandIndex++], 2, '.', '');
                    $row['arithmetic_amount'] = true;
                    $rows[] = $row;
                }
                continue;
            }
            $target = array_sum(array_map('floatval', array_slice($operands, $operandIndex)));
            $current = array_sum(array_map(static fn(array $row): float => (float)($row['amount'] ?? 0), $blockRows));
            if ($current <= 0) return null;
            foreach ($blockRows as $row) {
                $ratio = (float)($row['amount'] ?? 0) / $current;
