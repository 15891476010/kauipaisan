        }
        return $rows === [] ? null : $rows;
    }

    /** Attach one or more continuation number lines to the preceding play. */
    private function compilePlayWithContinuationNumbers(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r?\n/u', $source) ?: []), static fn(string $line): bool => $line !== ''));
        if (count($lines) < 2) return null;
        $tail = $this->surface($lines[array_key_last($lines)]);
        if (!preg_match('/^(?:合计|共计|总计|总合|合共|共合|小计|结算|合|🈴)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|快)?$/u', $tail, $total)) return null;
        array_pop($lines);
        $playIndex = -1; $numbers = [];
        foreach ($lines as $index => $line) {
            $normalized = $this->surface($line);
            if (preg_match('/^(?:福体|福|体)?\s*(?:直|单|组|组三|组六|直组|组直)\s*(?:各|每)?\s*(?:[一二两三四五六七八九十\d]+(?:\.\d+)?)?\s*(?:元|米|块|角|毛|倍|注)?$/u', $normalized) === 1) {
                $playIndex = $index;
                continue;
            }
            $normalizedNumbers = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $normalized) ?? $normalized;
            if (preg_match('/^(?:\d{3}(?:\s+\d{3})*)$/u', $normalizedNumbers) === 1) {
                preg_match_all('/\d{3}/u', $normalizedNumbers, $matches);
                $numbers = array_merge($numbers, $matches[0] ?? []);
            }
        }
        if ($playIndex < 0 || $numbers === []) return null;
        $playText = $this->surface($lines[$playIndex]);
        $prefix = implode(' ', array_slice($lines, 0, $playIndex));
        $joined = trim($prefix.' '.implode(' ', $numbers).' '.$playText);
        $compiled = $this->compile($joined, $lottery, $unitStake);
        if (!$compiled->matchedInput()) return null;
        $rows = $compiled->rows;
        $declared = $this->rules->amountWithUnit((float)$total[1], (string)($total[2] ?? ''), $unitStake);
        $calculated = array_sum(array_map(static fn(array $row): float => (float)($row['amount'] ?? 0), $rows));
        if (abs($declared - $calculated) > 0.001) return null;
        foreach ($rows as &$row) { $row['raw_text'] = $source; $row['input_text'] = $source; }
        unset($row);
        return $rows;
    }

    /** Parse “169注各单0.2米共计169*0.2=33.8米”. */
    private function compileEllipsisDirectGroupTotal(string $source, string $body, string $category, float $unitStake): ?array
