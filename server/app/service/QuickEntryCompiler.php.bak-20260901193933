    /** Compile “全托” as a deterministic full drag over the remaining digits. */
    private function compileFullDrag(string $source, string $body, string $category, float $unitStake): ?array
    {
        $body = trim(str_replace(['福体', '福', '体'], ' ', $body));
        $body = preg_replace('/\s+/u', ' ', $body) ?? $body;
        if (!str_contains($body, '全托')) return null;
        if (!preg_match('/^(\d{1,2})\s*(?:(组三|组六)\s*)?全托\s*(.*)$/u', $body, $head)) return null;
        $bankers = $this->unique(str_split($head[1]));
        $families = [];
        $tail = (string)$head[3];
        if (($head[2] ?? '') !== '') $tail = (string)$head[2].' '.$tail;
        preg_match_all('/(组三|组六)\s*(?:各|每)?\s*([一二两三四五六七八九十\d]+)\s*(倍|注|元|米|块|角|毛)?/u', $tail, $matches, PREG_SET_ORDER);
        foreach ($matches as $match) {
            $value = $this->numericToken((string)$match[2]);
            if ($value !== null) $families[(string)$match[1]] = [$value, (string)($match[3] ?? '')];
        }
        if ($families === [] && preg_match('/(组三|组六)\s*(?:各|每)?\s*([一二两三四五六七八九十\d]+)\s*(倍|注|元|米|块|角|毛)?/u', $head[2], $single)) {
            $value = $this->numericToken((string)$single[2]);
            if ($value !== null) $families[(string)$single[1]] = [$value, (string)($single[3] ?? '')];
        }
        if ($families === []) return [$this->failure($source, '全托玩法或金额不明确')];
        $drags = array_values(array_diff(range(0, 9), array_map('intval', $bankers)));
        $categoryCount = $category === '福体' ? 2 : 1;
        $rows = [];
        foreach ($families as $family => [$value, $unit]) {
            $identity = $this->rules->dragPlay($family, count($bankers), count($drags));
            if ($identity === null) return [$this->failure($source, '全托胆码或拖码数量与玩法不一致')];
            $unitAmount = $unit === '倍'
                ? $this->rules->multiplierAmount(count($bankers) === 2 ? BetMultiplierAmount::GROUP_SIX_DOUBLE_DRAG : BetMultiplierAmount::GROUP_DRAG, (float)$value, count($drags))
                : $this->rules->amountWithUnit((float)$value, (string)$unit, $unitStake);
            $amount = $unitAmount * $categoryCount;
            $row = $this->row($source, $body, [$head[1].'拖'.implode('', $drags)], $category, $identity['name'], $amount, $categoryCount, $categoryCount, '', 1);
            $row['number_text'] = '胆'.$head[1].'拖'.implode('', $drags);
            $row['display_number_text'] = '胆'.$head[1].'拖'.implode('', $drags);
            $row['settlement_text'] = $family.'胆拖 胆'.$head[1].'拖'.implode('', $drags).' '.$identity['name'].' '.$category;
            $rows[] = $row;
        }
        if (preg_match('/(?:合计|共计|合)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛)?/u', $body, $totalMatch)) {
            $declared = $this->rules->amountWithUnit((float)$totalMatch[1], (string)($totalMatch[2] ?? ''), $unitStake);
            $calculated = array_sum(array_map(static fn(array $row): float => (float)$row['amount'], $rows));
            if (abs($declared - $calculated) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
        }
        return $rows;
    }

    /** Merge only an unambiguous prefix/number/suffix multi-line ticket. */
    private function compileMultilineSimple(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r?\n/u', $source) ?: []), static fn(string $line): bool => $line !== ''));
        // A trailing arithmetic line such as “合计52+20=72” summarizes this
        // ticket and any previous ticket; it is not part of the grammar.
        if ($lines !== [] && preg_match('/^(?:福体|福|体)?\s*(?:合计|共计|总计|总合|合共|共合|小计|结算|🈴)\s*\d+(?:\.\d+)?\s*[+*×]\s*\d+(?:\.\d+)?\s*=\s*\d+(?:\.\d+)?/u', $this->surface($lines[array_key_last($lines)])) === 1) array_pop($lines);
        if (count($lines) < 2) return null;
        $first = $this->surface($lines[0]);
        $prefix = '';
        if (preg_match('/^(福体|福|体)$/u', $first) === 1) { $prefix = $first; array_shift($lines); }
        if (count($lines) < 2) return null;
        $last = $this->surface($lines[array_key_last($lines)]);
        if (!preg_match('/(?:直|单|组|组三|组六|复式|胆拖|飞|定位|和值|跨度)/u', $last)) return null;
        $numberLines = array_slice($lines, 0, -1);
        foreach ($numberLines as $line) {
            $normalized = $this->surface($line);
            $normalizedNumbers = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $normalized) ?? $normalized;
            if (preg_match('/^(?:\d{3}(?:\s+\d{3})*|\d{2,10})$/u', $normalizedNumbers) !== 1
                && preg_match('/(?:百|十|个)\s*[0-9]/u', $normalized) !== 1) return null;
        }
        $joined = trim($prefix.' '.implode(' ', $lines));
        $compiled = $this->compile($joined, $lottery, $unitStake);
        if (!$compiled->matchedInput()) return null;
        // Keep the complete physical input for preview/audit while using the
        // joined sentence only as the parser's normalized source.
        $rows = $compiled->rows;
        foreach ($rows as &$row) {
            $row['raw_text'] = $source;
            $row['input_text'] = $source;
        }
        unset($row);
        return $rows;
    }

