<?php
declare(strict_types=1);

namespace app\service;

/**
 * Strict V2 quick-entry compiler.
 *
 * It only accepts grammars that have one interpretation. A recognized but
 * invalid sentence returns a failed row and must never fall through to the
 * compatibility parser.
 */
final class QuickEntryCompiler
{
    public function __construct(private readonly QuickEntryRules $rules = new QuickEntryRules()) {}

    public function compile(string $source, string $lottery, float $unitStake): QuickEntryCompileResult
    {
        $source = trim(mb_substr($source, 0, QuickEntryRules::MAX_TEXT_LENGTH));
        if ($source === '') return QuickEntryCompileResult::noMatch();

        // “打二单一组6” uses the trailing 6 as the whole-ticket amount;
        // normalizing “组6” too early would turn the generic 组 into 组六.
        // Keep this wording visible as an ambiguity so the user can choose
        // 组三/组六 explicitly instead of silently selecting an odds class.
        $daDirectGroup = $this->compileDaDirectGroup($source, $lottery, $unitStake);
        if ($daDirectGroup !== null) return QuickEntryCompileResult::matched($daDirectGroup);

        // Order-independent grammar for the new parser path. It is enabled
        // only when the sentence uses genuinely free-order shorthand (e.g.
        // 一直一组/单挑 or a total line before the play); canonical legacy
        // sentences remain untouched until their AST migrations are complete.
        // Keep the legacy bare “一直组” meaning intact (it historically
        // denotes the 组六 shorthand).  The free-order grammar is only for
        // an explicit direct/group count such as “一直一组” or “一直两组”.
        // Otherwise the legacy parser below must get the sentence so old
        // tickets do not silently gain a 直 leg.
        if (preg_match('/一直[一二两三四五六七八九十\d]+组|单挑/u', $source) === 1) {
            $unordered = $this->compileUnorderedTicket($source, $lottery, $unitStake);
            if ($unordered !== null) return QuickEntryCompileResult::matched($unordered);
        }

        $arithmeticDirectGroup = $this->compileArithmeticDirectGroupCount($source, $lottery, $unitStake);
        if ($arithmeticDirectGroup !== null) return QuickEntryCompileResult::matched($arithmeticDirectGroup);

        if (str_contains($source, "\n") && preg_match("/\n\s*\n/u", $source) === 1) {
            $separatedTotal = $this->compileSeparatedTicketsWithTotal($source, $lottery, $unitStake);
            if ($separatedTotal !== null) return QuickEntryCompileResult::matched($separatedTotal);
            $arithmeticTickets = $this->compileArithmeticTickets($source, $lottery, $unitStake);
            if ($arithmeticTickets !== null) return QuickEntryCompileResult::matched($arithmeticTickets);
        }

        if (str_contains($source, "\n")) {
            $multilineAmountBeforeDirect = $this->compileMultilineAmountBeforeDirect($source, $lottery, $unitStake);
            if ($multilineAmountBeforeDirect !== null) return QuickEntryCompileResult::matched($multilineAmountBeforeDirect);
            $multilineCountedMultiplier = $this->compileMultilineCountedMultiplierDirect($source, $lottery, $unitStake);
            if ($multilineCountedMultiplier !== null) return QuickEntryCompileResult::matched($multilineCountedMultiplier);
            // A long number paste may put the lottery/play declaration on a
            // separate final line, e.g. “福：186注直各5合计930”.  This is a
            // single direct ticket: keep the physical number occurrences,
            // validate the declared N and total, and never let the legacy
            // line-batch parser reinterpret the trailing numbers.
            $declaredDirect = $this->compileTrailingDeclaredDirect($source, $lottery, $unitStake);
            if ($declaredDirect !== null) return QuickEntryCompileResult::matched($declaredDirect);
            $compactPositionBatch = $this->compileCompactPositionBatchWithTotal($source, $lottery, $unitStake);
            if ($compactPositionBatch !== null) return QuickEntryCompileResult::matched($compactPositionBatch);
            $repeatedSinglePosition = $this->compileRepeatedSinglePositionBlocks($source, $lottery, $unitStake);
            if ($repeatedSinglePosition !== null) return QuickEntryCompileResult::matched($repeatedSinglePosition);
            $standalonePositionBlock = $this->compileStandalonePositionBlock($source, $lottery, $unitStake);
            if ($standalonePositionBlock !== null) return QuickEntryCompileResult::matched($standalonePositionBlock);
            $repeatedPosition = $this->compileRepeatedPositionBlocks($source, $lottery, $unitStake);
            if ($repeatedPosition !== null) return QuickEntryCompileResult::matched($repeatedPosition);
            $trailingPlayTotal = $this->compileTrailingPlayWithTotal($source, $lottery, $unitStake);
            if ($trailingPlayTotal !== null) return QuickEntryCompileResult::matched($trailingPlayTotal);
            $mixedLinesTotal = $this->compileMixedLinesWithTotal($source, $lottery, $unitStake);
            if ($mixedLinesTotal !== null) return QuickEntryCompileResult::matched($mixedLinesTotal);
            $leadingPlayBatch = $this->compileLeadingPlayMultilineBatch($source, $lottery, $unitStake);
            if ($leadingPlayBatch !== null) return QuickEntryCompileResult::matched($leadingPlayBatch);
            $singleChallengeBatch = $this->compileTrailingSingleChallengeBatch($source, $lottery, $unitStake);
            if ($singleChallengeBatch !== null) return QuickEntryCompileResult::matched($singleChallengeBatch);
            $numbersTotalThenPlay = $this->compileNumbersTotalThenPlay($source, $lottery, $unitStake);
            if ($numbersTotalThenPlay !== null) return QuickEntryCompileResult::matched($numbersTotalThenPlay);
            $categoryCodeTicket = $this->compileMultilineCategoryCodeTicket($source, $lottery, $unitStake);
            if ($categoryCodeTicket !== null) return QuickEntryCompileResult::matched($categoryCodeTicket);
            $lineTerminated = $this->compileLineTerminatedTickets($source, $lottery, $unitStake);
            if ($lineTerminated !== null) return QuickEntryCompileResult::matched($lineTerminated);
            $trailingTotal = $this->compileTrailingTotalTicket($source, $lottery, $unitStake);
            if ($trailingTotal !== null) return QuickEntryCompileResult::matched($trailingTotal);
        }

        // Blank lines are ticket boundaries. Compile each complete block
        // independently so a complex paste cannot leak its amount or play
        // markers into the next ticket.
        if (preg_match("/\n\s*\n/u", $source) === 1) {
            $blocks = preg_split("/\n\s*\n/u", $source) ?: [];
            $rows = [];
            foreach ($blocks as $block) {
                $block = trim((string)$block);
                if ($block === '') continue;
                $compiled = $this->compile($block, $lottery, $unitStake);
                if (!$compiled->matchedInput()) return QuickEntryCompileResult::noMatch();
                $rows = array_merge($rows, $compiled->rows);
            }
            return $rows === [] ? QuickEntryCompileResult::noMatch() : QuickEntryCompileResult::matched($rows);
        }

        if (str_contains($source, "\n")) {
            if (str_contains($source, '全托')) {
                $fullDrag = $this->compileFullDrag($source, $this->surface(implode(' ', preg_split('/\r?\n/u', $source) ?: [])), $this->category($this->surface($source), $lottery), $unitStake);
                if ($fullDrag !== null) return QuickEntryCompileResult::matched($fullDrag);
            }
            $continuous = $this->compileContinuousTickets($source, $lottery, $unitStake);
            if ($continuous !== null) return QuickEntryCompileResult::matched($continuous);
        }

        // A single ticket may wrap a second play onto the next physical line
        // without a blank separator (for example “沾边赖组六10倍\n组三5倍”).
        if (str_contains($source, "\n")) {
            $wrapped = $this->compileWrappedComposite($source, $lottery, $unitStake);
            if ($wrapped !== null) return QuickEntryCompileResult::matched($wrapped);
            $multiline = $this->compileMultilineSimple($source, $lottery, $unitStake);
            if ($multiline !== null) return QuickEntryCompileResult::matched($multiline);
            $multiPlayLines = $this->compileMultilinePlayLines($source, $lottery, $unitStake);
            if ($multiPlayLines !== null) return QuickEntryCompileResult::matched($multiPlayLines);
            $playContinuation = $this->compilePlayWithContinuationNumbers($source, $lottery, $unitStake);
            if ($playContinuation !== null) return QuickEntryCompileResult::matched($playContinuation);
            // More than two unseparated physical lines can contain several
            // independent tickets. Leave those to the ticket segmenter
            // instead of flattening every play into one V2 sentence.
            if (count(preg_split('/\r?\n/u', $source) ?: []) > 2) return QuickEntryCompileResult::noMatch();
        }

        $normalized = $this->surface($source);
        $compoundTotal = $this->compileCompoundWithDeclaredTotal($source, $normalized, $lottery, $unitStake);
        if ($compoundTotal !== null) return QuickEntryCompileResult::matched($compoundTotal);
        $fuTiCompoundCash = $this->compileFuTiCompoundCash($source, $normalized, $unitStake);
        if ($fuTiCompoundCash !== null) return QuickEntryCompileResult::matched($fuTiCompoundCash);
        if (preg_match($this->rules->pattern('unsupported_play'), $normalized, $unsupported)) {
            return QuickEntryCompileResult::matched([$this->failure($source, '当前赔率目录未配置“'.$unsupported[0].'”玩法，已禁止下注')]);
        }
        $category = $this->category($normalized, $lottery);
        $body = trim(str_replace(['福体', '福', '体'], ' ', $normalized));
        $body = preg_replace('/\s+/u', ' ', $body) ?? $body;

        // Long direct-number pastes commonly put the per-number amount
        // before the play marker (for example “...999福一米直”), and may
        // include a declared count anywhere around the lottery marker
        // (“...999共355注福一米直” or “...999福一米直共355注”).  The generic
        // compatibility parser sees the Chinese “一” as 001 and the count
        // 355 as another three-digit selection.  Consume this unambiguous
        // grammar first, leaving only actual three-digit selections in the
        // number source.
        $amountBeforeDirect = $this->compileAmountBeforeDirect($source, $body, $category, $unitStake);
        if ($amountBeforeDirect !== null) return QuickEntryCompileResult::matched($amountBeforeDirect);

        $annotatedCountSuffix = $this->compileAnnotatedCountSuffix($source, $body, $category, $unitStake);
        if ($annotatedCountSuffix !== null) return QuickEntryCompileResult::matched($annotatedCountSuffix);

        $listedCounted = $this->compileListedCountedDirectGroup($source, $body, $category, $unitStake);
        if ($listedCounted !== null) return QuickEntryCompileResult::matched($listedCounted);

        $declaredCountAmount = $this->compileDeclaredCountAmount($source, $body, $category, $unitStake);
        if ($declaredCountAmount !== null) return QuickEntryCompileResult::matched($declaredCountAmount);

        $fuTiDeclaredDirect = $this->compileFuTiDeclaredDirect($source, $normalized, $unitStake);
        if ($fuTiDeclaredDirect !== null) return QuickEntryCompileResult::matched($fuTiDeclaredDirect);

        $ellipsisDirectGroup = $this->compileEllipsisDirectGroupTotal($source, $body, $category, $unitStake);
        if ($ellipsisDirectGroup !== null) return QuickEntryCompileResult::matched($ellipsisDirectGroup);

        $prefixedAmountDirectGroup = $this->compileAmountBeforeDirectGroup($source, $body, $category, $unitStake);
        if ($prefixedAmountDirectGroup !== null) return QuickEntryCompileResult::matched($prefixedAmountDirectGroup);

        $countSuffix = $this->compileNumberListCountSuffix($source, $body, $category, $unitStake);
        if ($countSuffix !== null) return QuickEntryCompileResult::matched($countSuffix);

        $valueGroup = $this->compileNumberListValueGroup($source, $body, $category, $unitStake);
        if ($valueGroup !== null) return QuickEntryCompileResult::matched($valueGroup);

        $oneGroup = $this->compileNumberListSingleGroup($source, $body, $category, $unitStake);
        if ($oneGroup !== null) return QuickEntryCompileResult::matched($oneGroup);

        $groupTotal = $this->compileNumberListGroupTotal($source, $body, $category, $unitStake);
        if ($groupTotal !== null) return QuickEntryCompileResult::matched($groupTotal);

        $prefixCatalogMultiplier = $this->compilePrefixCatalogMultiplier($source, $body, $category, $unitStake);
        if ($prefixCatalogMultiplier !== null) return QuickEntryCompileResult::matched($prefixCatalogMultiplier);

        $numberStake = $this->compileNumberListStakeCount($source, $body, $category, $unitStake);
        if ($numberStake !== null) return QuickEntryCompileResult::matched($numberStake);

        $listedDirectMultiplier = $this->compileListedDirectMultiplier($source, $body, $category, $unitStake);
        if ($listedDirectMultiplier !== null) return QuickEntryCompileResult::matched($listedDirectMultiplier);

        $countPrefix = $this->compileCountPrefixList($source, $body, $category, $unitStake);
        if ($countPrefix !== null) return QuickEntryCompileResult::matched($countPrefix);

        $moneyPair = $this->compileNumberListMoneyPair($source, $body, $category, $unitStake);
        if ($moneyPair !== null) return QuickEntryCompileResult::matched($moneyPair);

        $mixed = $this->compileMixedDirectGroup($source, $body, $category, $unitStake);
        if ($mixed !== null) return QuickEntryCompileResult::matched($mixed);

        $wrapped = $this->compileWrappedDirectGroup($source, $body, $category, $unitStake);
        if ($wrapped !== null) return QuickEntryCompileResult::matched($wrapped);

        $selectionGroups = $this->compileSelectionGroups($source, $body, $category, $unitStake);
        if ($selectionGroups !== null) return QuickEntryCompileResult::matched($selectionGroups);

        $special = $this->compileSpecial($source, $body, $category, $unitStake);
        if ($special !== null) return QuickEntryCompileResult::matched($special);

        $catalog = $this->compileCatalog($source, $body, $category, $unitStake);
        if ($catalog !== null) return QuickEntryCompileResult::matched($catalog);

        $composite = $this->compileComposite($source, $body, $category, $unitStake);
        if ($composite !== null) return QuickEntryCompileResult::matched($composite);

        $explicitLianCatalog = $this->compileExplicitLianCatalog($source, $body, $category, $unitStake);
        if ($explicitLianCatalog !== null) return QuickEntryCompileResult::matched($explicitLianCatalog);

        $lian = $this->compileLian($source, $body, $category, $unitStake);
        if ($lian !== null) return QuickEntryCompileResult::matched($lian);

        $singleFullDrag = $this->compileSingleFullDrag($source, $body, $category, $unitStake);
        if ($singleFullDrag !== null) return QuickEntryCompileResult::matched($singleFullDrag);

        $drag = $this->compileDrag($source, $body, $category, $unitStake);
        if ($drag !== null) return QuickEntryCompileResult::matched($drag);

        $fullDrag = $this->compileFullDrag($source, $body, $category, $unitStake);
        if ($fullDrag !== null) return QuickEntryCompileResult::matched($fullDrag);

        $singleGroupCompound = $this->compileSingleGroupCompound($source, $body, $category);
        if ($singleGroupCompound !== null) return QuickEntryCompileResult::matched($singleGroupCompound);

        $positionCompound = $this->compilePositionCompound($source, $body, $category, $unitStake);
        if ($positionCompound !== null) return QuickEntryCompileResult::matched($positionCompound);

        $explicitGroupTotal = $this->compileExplicitGroupTotal($source, $body, $category, $unitStake);
        if ($explicitGroupTotal !== null) return QuickEntryCompileResult::matched($explicitGroupTotal);

        $prefixGroupTotal = $this->compilePrefixGroupTotal($source, $body, $category, $unitStake);
        if ($prefixGroupTotal !== null) return QuickEntryCompileResult::matched($prefixGroupTotal);

        $groupMultiplierTotal = $this->compileGroupSixMultiplierTotal($source, $body, $category, $unitStake);
        if ($groupMultiplierTotal !== null) return QuickEntryCompileResult::matched($groupMultiplierTotal);

        $compactMixedMultiplier = $this->compileCompactMixedMultiplier($source, $body, $category);
        if ($compactMixedMultiplier !== null) return QuickEntryCompileResult::matched($compactMixedMultiplier);

        $separateMultiCode = $this->compileSeparateMultiCodeLines($source, $lottery, $unitStake);
        if ($separateMultiCode !== null) return QuickEntryCompileResult::matched($separateMultiCode);

        $multiCode = $this->compileMultiCode($source, $body, $category, $unitStake);
        if ($multiCode !== null) return QuickEntryCompileResult::matched($multiCode);

        $counted = $this->compileCountedDirectGroup($source, $body, $category, $unitStake);
        if ($counted !== null) return QuickEntryCompileResult::matched($counted);

        $explicit = $this->compileExplicitNumberList($source, $body, $category, $unitStake);
        if ($explicit !== null) return QuickEntryCompileResult::matched($explicit);

        // Multiple three-digit selections without a play/amount marker are
        // ambiguous. Do not let the compatibility parser consume the last
        // selection as a stake count.
        preg_match_all('/(?<!\d)\d{3}(?!\d)/u', $body, $numberMatches);
        if (count($numberMatches[0] ?? []) >= 2 && !preg_match('/直|单|组|复式|定位|和值|跨度|胆|拖|飞|豹子/u', $body)) {
            return QuickEntryCompileResult::matched([$this->failure($source, '未识别到玩法')]);
        }

        return QuickEntryCompileResult::noMatch();
    }

    /** Parse “四码组六3倍0479” / “五码组六三倍03479”. */
    private function compilePrefixCatalogMultiplier(string $source, string $body, string $category, float $unitStake): ?array
    {
        if (!preg_match('/^([一二两三四五六七八九十\d]+)\s*码\s*(组三|组六)\s*([一二两三四五六七八九十\d]+)\s*倍\s*(\d{2,10})$/u', $body, $m)) return null;
        $requested = $this->integerToken((string)$m[1]);
        $multiplier = $this->numericToken((string)$m[3]);
        $selection = implode('', $this->unique(str_split((string)$m[4])));
        if ($requested === null || $multiplier === null || strlen($selection) !== $requested) return [$this->failure($source, '所选数字数量与玩法不一致')];
        if ($m[2] === '组六' && $requested < 3) return [$this->groupSixMultiCodeFailure($source)];
        if ($m[2] === '组三' && $requested < 2) return [$this->failure($source, '组三选号数量不足')];
        $categoryCount = $category === '福体' ? 2 : 1;
        $numbers = $m[2] === '组六' && $requested >= 4 ? $this->groupSixCombinations(str_split($selection)) : ($m[2] === '组三' && $requested >= 3 ? $this->groupThreeCombinations(str_split($selection)) : [$selection]);
        $play = ($requested === 3 && $m[2] === '组六') || ($requested === 3 && $m[2] === '组三' && count(array_unique(str_split($selection))) === 2) ? $m[2] : $m[2].$this->countWord($requested);
        $amount = $this->rules->multiplierAmount(BetMultiplierAmount::GROUP_OTHER, $multiplier) * $categoryCount;
        $row = $this->row($source, $body, $numbers, $category, $play, $amount, $categoryCount, $categoryCount, '', 1);
        $row['amount_type'] = 'multiplier'; $row['multiplier'] = $multiplier;
        return [$row];
    }

    /** Split a paste where plain numeric total lines terminate each ticket. */
    private function compileLineTerminatedTickets(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r?\n/u', $source) ?: []), static fn(string $line): bool => $line !== ''));
        if (count($lines) < 3) return null;
        $grandTotal = null;
        $last = $this->surface($lines[array_key_last($lines)]);
        if (preg_match('/^(?:🈴|合计|共计|总计|总合|合共|共合|小计|结算)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|快)?$/u', $last, $grand)) {
            $grandTotal = $this->rules->amountWithUnit((float)$grand[1], (string)($grand[2] ?? ''), $unitStake);
            array_pop($lines);
        }
        if ($grandTotal === null) return null;
        $blocks = []; $current = [];
        foreach ($lines as $line) {
            $current[] = $line;
            $normalized = $this->surface($line);
            if (preg_match('/^\d+(?:\.\d+)?\s*(?:元|米|块|角|毛|快)?$/u', $normalized) === 1) {
                $blocks[] = $current; $current = [];
            }
        }
        if ($current !== []) $blocks[] = $current;
        if (count($blocks) < 2) return null;
        $rows = [];
        foreach ($blocks as $blockLines) {
            $ticketTotalLine = array_pop($blockLines);
            $ticketTotal = $this->rules->amountWithUnit((float)$ticketTotalLine, '', $unitStake);
            // Number lines may continue a preceding play line. Join them
            // before adding the ticket's numeric total marker.
            $joined = [];
            foreach ($blockLines as $line) {
                $normalized = $this->surface($line);
                $normalizedNumbers = preg_replace('/(?<=\d)[-—－](?=\d)/u', ' ', $normalized) ?? $normalized;
                if ($joined !== [] && preg_match('/^(?:\d{3}(?:\s+\d{3})*)$/u', $normalizedNumbers) === 1) {
                    $joined[array_key_last($joined)] .= ' '.$normalizedNumbers;
                } else {
                    $joined[] = $line;
                }
            }
            $block = implode("\n", $joined);
            $compiled = $this->compile($block, $lottery, $unitStake);
            if (!$compiled->matchedInput()) {
                $independent = $this->compileIndependentLines($block, $lottery, $unitStake);
                if ($independent === null) return null;
                $blockRows = $independent;
            } else {
                $blockRows = $compiled->rows;
            }
            $blockAmount = array_sum(array_map(static fn(array $row): float => (float)($row['amount'] ?? 0), $blockRows));
            if (abs($blockAmount - $ticketTotal) > 0.001) return null;
            $rows = array_merge($rows, $blockRows);
        }
        $actual = array_sum(array_map(static fn(array $row): float => (float)($row['amount'] ?? 0), $rows));
        if (abs($actual - $grandTotal) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
        foreach ($rows as &$row) { $row['raw_text'] = $source; $row['input_text'] = $source; }
        unset($row);
        return $rows;
    }

    /** Parse “一单444 777” and “一单一组309 241 …”. */
    private function compileCountPrefixList(string $source, string $body, string $category, float $unitStake): ?array
    {
        $direct = null; $group = null; $numbersText = null;
        if (preg_match('/^((?:[零〇一二两三四五六七八九十]|\d{1,2}))\s*(?:单|直)\s*(\d{3}(?:\s+\d{3})*)$/u', $body, $single)) {
            $direct = $this->integerToken((string)$single[1]); $numbersText = $single[2];
        } elseif (preg_match('/^((?:[零〇一二两三四五六七八九十]|\d{1,2}))\s*(?:单|直)\s*((?:[零〇一二两三四五六七八九十]|\d{1,2}))\s*(?:组|组六)\s*(\d{3}(?:\s+\d{3})*)$/u', $body, $pair)) {
            $direct = $this->integerToken((string)$pair[1]); $group = $this->integerToken((string)$pair[2]); $numbersText = $pair[3];
        }
        if ($direct === null || $direct < 1 || $numbersText === null) return null;
        if ($group === null) $group = 0;
        $numbers = preg_split('/\s+/u', trim($numbersText), -1, PREG_SPLIT_NO_EMPTY) ?: [];
        if ($numbers === []) return [$this->failure($source, '未识别到有效号码')];
        $categoryCount = $category === '福体' ? 2 : 1;
        // Each entered code is an individual stake. Preserve the original
        // list (including permutations such as 849 and 948) in both direct
        // and group details; only the group family is inferred from shape.
        $rows = [$this->row($source, $body, $numbers, $category, '直', count($numbers) * $direct * $unitStake * $categoryCount, count($numbers) * $categoryCount, count($numbers) * $direct * $categoryCount, '直', $direct)];
        if ($group > 0) {
            foreach ($this->groupedNumbers($numbers, '组') as $groupPlay => $groupNumbers) {
                $occurrences = count($groupNumbers);
                $rows[] = $this->row($source, $body, $groupNumbers, $category, $groupPlay, $occurrences * $group * $unitStake * $categoryCount, $occurrences * $categoryCount, $occurrences * $group * $categoryCount, '组', $group);
            }
        }
        return $rows;
    }

    /** Compile a multi-line ticket whose last line is a plain total marker. */
    private function compileTrailingTotalTicket(string $source, string $lottery, float $unitStake): ?array
    {
        $lines = preg_split('/\r?\n/u', $source) ?: [];
        while ($lines !== [] && trim((string)end($lines)) === '') array_pop($lines);
        if (count($lines) < 2) return null;
        $last = $this->surface((string)$lines[array_key_last($lines)]);
        if (!preg_match('/^(?:合计|共计|总计|总合|合共|共合|小计|结算|合)\s*(\d+(?:\.\d+)?)\s*(元|米|块|角|毛|快)?$/u', $last, $totalMatch)) return null;
        $declared = $this->rules->amountWithUnit((float)$totalMatch[1], (string)($totalMatch[2] ?? ''), $unitStake);
        array_pop($lines);
        $ticket = implode("\n", $lines);
        $compiled = $this->compile($ticket, $lottery, $unitStake);
        $rows = $compiled->matchedInput() ? $compiled->rows : $this->compileIndependentLines($ticket, $lottery, $unitStake);
        if ($rows === null || $rows === []) return null;
        $calculated = array_sum(array_map(static fn(array $row): float => (float)($row['amount'] ?? 0), $rows));
        if (abs($declared - $calculated) > 0.001) return [$this->failure($source, '整张总金额与识别金额不一致')];
        foreach ($rows as &$row) { $row['raw_text'] = $source; $row['input_text'] = $source; }
        unset($row);
        return $rows;
    }

    /** Parse independent physical lines after a shared total marker. */
    private function compileIndependentLines(string $source, string $lottery, float $unitStake): ?array
    {
        $rows = [];
        foreach (preg_split('/\r?\n/u', $source) ?: [] as $line) {
            $line = trim((string)$line);
            if ($line === '') continue;
            $compiled = $this->compile($line, $lottery, $unitStake);
            if (!$compiled->matchedInput()) return null;
            $rows = array_merge($rows, $compiled->rows);
        }
        return $rows === [] ? null : $rows;
    }

    /** Compile multiple tickets followed by an arithmetic grand-total line. */
    private function compileArithmeticTickets(string $source, string $lottery, float $unitStake): ?array
    {
